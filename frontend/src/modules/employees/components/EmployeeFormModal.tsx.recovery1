import { useEffect } from "react";
import { useForm } from "react-hook-form";
import { z } from "zod";
import { zodResolver } from "@hookform/resolvers/zod";
import { BriefcaseBusiness, Contact, ShieldPlus, UserPlus, Wallet } from "lucide-react";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Select } from "@/components/ui/select";
import { Textarea } from "@/components/ui/textarea";
import { Modal } from "@/components/ui/modal";
import { FormField } from "@/components/forms/FormField";
import type { EmployeeCatalogs, EmployeeDetail, EmployeePayload } from "@/modules/employees/types/employee.types";

const schema = z.object({
  employeeCode: z.string().min(2, "C?digo requerido"),
  firstName: z.string().min(2, "Nombre requerido"),
  lastName: z.string().min(2, "Apellido requerido"),
  documentType: z.string().min(2, "Tipo de documento requerido"),
  documentNumber: z.string().min(5, "Documento requerido"),
  birthDate: z.string().min(1, "Fecha de nacimiento requerida"),
  hireDate: z.string().min(1, "Fecha de ingreso requerida"),
  baseSalary: z.coerce.number().min(0, "Sueldo inv?lido"),
  personalEmail: z.string().email("Correo personal inv?lido"),
  workEmail: z.string().email("Correo corporativo inv?lido"),
  phoneNumber: z.string().min(6, "Tel?fono requerido"),
  profilePhotoUrl: z.string().optional(),
  notes: z.string().optional(),
  emergencyContactName: z.string().optional(),
  emergencyContactPhone: z.string().optional(),
  emergencyContactRelationship: z.string().optional(),
  contractEndDate: z.string().optional(),
  bankName: z.string().optional(),
  bankAccountNumber: z.string().optional(),
  bankAccountCci: z.string().optional().refine((v) => !v || /^\d{20}$/.test(v), { message: "El CCI debe tener 20 d?gitos" }),
  bankAccountType: z.string().optional(),
  bankCurrency: z.string().optional(),
  branchId: z.string().min(1, "Sede requerida"),
  areaId: z.string().min(1, "?rea requerida"),
  positionId: z.string().min(1, "Cargo requerido"),
  contractTypeId: z.string().min(1, "Tipo de contrato requerido"),
  managerId: z.string().optional(),
  gender: z.string().optional(),
  maritalStatus: z.string().optional(),
  nationality: z.string().optional()
});

type EmployeeFormValues = z.infer<typeof schema>;

type EmployeeFormModalProps = {
  open: boolean;
  mode: "create" | "edit";
  catalogs: EmployeeCatalogs | undefined;
  employee: EmployeeDetail | null;
  loadingEmployee: boolean;
  saving: boolean;
  onClose: () => void;
  onSubmit: (payload: EmployeePayload) => Promise<void>;
};

const defaultValues: EmployeeFormValues = {
  employeeCode: "",
  firstName: "",
  lastName: "",
  documentType: "DNI",
  documentNumber: "",
  birthDate: "",
  hireDate: "",
  baseSalary: 0,
  personalEmail: "",
  workEmail: "",
  phoneNumber: "",
  profilePhotoUrl: "",
  notes: "",
  emergencyContactName: "",
  emergencyContactPhone: "",
  emergencyContactRelationship: "",
  contractEndDate: "",
  bankName: "",
  bankAccountNumber: "",
  bankAccountCci: "",
  bankAccountType: "",
  bankCurrency: "PEN",
  branchId: "",
  areaId: "",
  positionId: "",
  contractTypeId: "",
  managerId: "",
  gender: "",
  maritalStatus: "",
  nationality: ""
};

function StepperTop(): JSX.Element {
  const steps = ["Datos personales", "Datos laborales", "Contacto", "Pago", "Documentos"];
  return (
    <div className="rounded-xl border border-slate-200 bg-white px-4 py-3">
      <div className="grid grid-cols-5 gap-2">
        {steps.map((s, i) => (
          <div key={s} className="text-center">
            <div className={`mx-auto mb-1 flex size-5 items-center justify-center rounded-full text-[11px] font-semibold ${i === 0  "bg-brand-500 text-white" : "bg-slate-200 text-slate-600"}`}>{i + 1}</div>
            <p className="text-[11px] text-slate-500">{s}</p>
          </div>
        ))}
      </div>
    </div>
  );
}

function SectionTitle({ icon: Icon, title }: { icon: React.ComponentType<{ className: string }>; title: string }): JSX.Element {
  return (
    <div className="mb-3 flex items-center gap-2">
      <div className="flex size-6 items-center justify-center rounded-md bg-brand-50 text-brand-600"><Icon className="size-3.5" /></div>
      <p className="text-sm font-semibold text-slate-800">{title}</p>
    </div>
  );
}

export function EmployeeFormModal({ open, mode, catalogs, employee, loadingEmployee, saving, onClose, onSubmit }: EmployeeFormModalProps): JSX.Element {
  const { register, handleSubmit, reset, formState: { errors } } = useForm<EmployeeFormValues>({ resolver: zodResolver(schema), defaultValues });

  useEffect(() => {
    if (!open) return;
    if (mode === "edit" && employee) {
      reset({
        employeeCode: employee.employeeCode,
        firstName: employee.firstName,
        lastName: employee.lastName,
        documentType: employee.documentType,
        documentNumber: employee.documentNumber,
        birthDate: employee.birthDate,
        hireDate: employee.hireDate,
        baseSalary: employee.baseSalary,
        personalEmail: employee.personalEmail,
        workEmail: employee.workEmail,
        phoneNumber: employee.phoneNumber,
        profilePhotoUrl: employee.profilePhotoUrl  "",
        notes: employee.notes  "",
        emergencyContactName: employee.emergencyContactName  "",
        emergencyContactPhone: employee.emergencyContactPhone  "",
        emergencyContactRelationship: "",
        contractEndDate: employee.contractEndDate  "",
        bankName: employee.bankName  "",
        bankAccountNumber: employee.bankAccountNumber  "",
        bankAccountCci: employee.bankAccountCci  "",
        bankAccountType: employee.bankAccountType  "",
        bankCurrency: employee.bankCurrency  "PEN",
        branchId: employee.branchId,
        areaId: employee.areaId,
        positionId: employee.positionId,
        contractTypeId: employee.contractTypeId,
        managerId: employee.managerId  "",
        gender: "",
        maritalStatus: "",
        nationality: ""
      });
      return;
    }
    reset(defaultValues);
  }, [employee, mode, open, reset]);

  const submit = handleSubmit(async (v) => {
    await onSubmit({
      employeeCode: v.employeeCode.trim(),
      firstName: v.firstName.trim(),
      lastName: v.lastName.trim(),
      documentType: v.documentType.trim(),
      documentNumber: v.documentNumber.trim(),
      birthDate: v.birthDate,
      hireDate: v.hireDate,
      baseSalary: Number(v.baseSalary),
      personalEmail: v.personalEmail.trim(),
      workEmail: v.workEmail.trim(),
      phoneNumber: v.phoneNumber.trim(),
      profilePhotoUrl: v.profilePhotoUrl.trim() || undefined,
      notes: v.notes.trim() || undefined,
      emergencyContactName: v.emergencyContactName.trim() || undefined,
      emergencyContactPhone: v.emergencyContactPhone.trim() || undefined,
      contractEndDate: v.contractEndDate || undefined,
      bankName: v.bankName.trim() || undefined,
      bankAccountNumber: v.bankAccountNumber.trim() || undefined,
      bankAccountCci: v.bankAccountCci.trim() || undefined,
      bankAccountType: v.bankAccountType || undefined,
      bankCurrency: v.bankCurrency || undefined,
      branchId: v.branchId,
      areaId: v.areaId,
      positionId: v.positionId,
      contractTypeId: v.contractTypeId,
      managerId: v.managerId || undefined
    });
  });

  return (
    <Modal open={open} title={mode === "create"  "Nuevo empleado" : "Editar empleado"} onClose={onClose}>
      {mode === "edit" && loadingEmployee  (
        <div className="py-8 text-sm text-muted">Cargando datos del empleado...</div>
      ) : (
        <form onSubmit={submit} className="space-y-3">
          <StepperTop />

          <div className="max-h-[66vh] space-y-3 overflow-y-auto pr-1">
            <div className="rounded-xl border border-slate-200 bg-white p-3">
              <SectionTitle icon={UserPlus} title="Informaci?n personal" />
              <div className="grid gap-3 md:grid-cols-5">
                <div className="rounded-xl border border-slate-200 bg-slate-50 p-3 text-center">
                  <div className="mx-auto mb-2 flex size-14 items-center justify-center rounded-full bg-brand-100 text-brand-600"><UserPlus className="size-6" /></div>
                  <p className="text-xs font-semibold text-slate-700">Agregar foto</p>
                  <p className="text-[11px] text-slate-400">JPG o PNG, m?x 2MB</p>
                </div>
                <div className="md:col-span-4 grid gap-3 md:grid-cols-3">
                  <FormField label="C?digo" required error={errors.employeeCode.message}><Input placeholder="Ej: EMP-0001" {...register("employeeCode")} /></FormField>
                  <FormField label="Tipo de documento" required error={errors.documentType.message}><Select {...register("documentType")}><option value="DNI">DNI</option><option value="CE">CE</option><option value="PAS">Pasaporte</option></Select></FormField>
                  <FormField label="N? Documento" required error={errors.documentNumber.message}><Input placeholder="Ej: 12345678" {...register("documentNumber")} /></FormField>
                  <FormField label="Nombres" required error={errors.firstName.message}><Input placeholder="Ej: Diego" {...register("firstName")} /></FormField>
                  <FormField label="Apellidos" required error={errors.lastName.message}><Input placeholder="Ej: Ramos" {...register("lastName")} /></FormField>
                  <FormField label="Fecha de nacimiento" required error={errors.birthDate.message}><Input type="date" {...register("birthDate")} /></FormField>
                  <FormField label="G?nero"><Select {...register("gender")}><option value="">Seleccionar</option><option value="M">Masculino</option><option value="F">Femenino</option></Select></FormField>
                  <FormField label="Estado civil"><Select {...register("maritalStatus")}><option value="">Seleccionar</option><option value="single">Soltero(a)</option><option value="married">Casado(a)</option></Select></FormField>
                  <FormField label="Nacionalidad"><Select {...register("nationality")}><option value="">Seleccionar</option><option value="PE">Peruana</option><option value="OT">Otra</option></Select></FormField>
                </div>
              </div>
            </div>

            <div className="rounded-xl border border-slate-200 bg-white p-3">
              <SectionTitle icon={BriefcaseBusiness} title="Informaci?n laboral" />
              <div className="grid gap-3 md:grid-cols-3">
                <FormField label="?rea" required error={errors.areaId.message}><Select {...register("areaId")}><option value="">Seleccionar ?rea</option>{catalogs.areas.map((i) => <option key={i.id} value={i.id}>{i.name}</option>)}</Select></FormField>
                <FormField label="Cargo" required error={errors.positionId.message}><Select {...register("positionId")}><option value="">Seleccionar cargo</option>{catalogs.positions.map((i) => <option key={i.id} value={i.id}>{i.name}</option>)}</Select></FormField>
                <FormField label="Sede" required error={errors.branchId.message}><Select {...register("branchId")}><option value="">Seleccionar sede</option>{catalogs.branches.map((i) => <option key={i.id} value={i.id}>{i.name}</option>)}</Select></FormField>
                <FormField label="Tipo de contrato" required error={errors.contractTypeId.message}><Select {...register("contractTypeId")}><option value="">Seleccionar tipo</option>{catalogs.contractTypes.map((i) => <option key={i.id} value={i.id}>{i.name}</option>)}</Select></FormField>
                <FormField label="Fecha de ingreso" required error={errors.hireDate.message}><Input type="date" {...register("hireDate")} /></FormField>
                <FormField label="Sueldo base" required error={errors.baseSalary.message}><Input type="number" step="0.01" placeholder="S/ 0.00" {...register("baseSalary")} /></FormField>
              </div>
            </div>

            <div className="rounded-xl border border-slate-200 bg-white p-3">
              <SectionTitle icon={Contact} title="Contacto" />
              <div className="grid gap-3 md:grid-cols-3">
                <FormField label="Correo corporativo" required error={errors.workEmail.message}><Input type="email" placeholder="ejemplo@empresa.com" {...register("workEmail")} /></FormField>
                <FormField label="Correo personal" required error={errors.personalEmail.message}><Input type="email" placeholder="ejemplo@gmail.com" {...register("personalEmail")} /></FormField>
                <FormField label="Tel?fono" required error={errors.phoneNumber.message}><Input placeholder="987 654 321" {...register("phoneNumber")} /></FormField>
              </div>
            </div>

            <div className="grid gap-3 md:grid-cols-2">
              <div className="rounded-xl border border-slate-200 bg-white p-3">
                <SectionTitle icon={ShieldPlus} title="Emergencia" />
                <div className="grid gap-3">
                  <FormField label="Contacto de emergencia"><Input placeholder="Nombre del contacto" {...register("emergencyContactName")} /></FormField>
                  <FormField label="Tel?fono de emergencia"><Input placeholder="987 654 321" {...register("emergencyContactPhone")} /></FormField>
                  <FormField label="Parentesco"><Select {...register("emergencyContactRelationship")}><option value="">Seleccionar parentesco</option><option value="Padre">Padre</option><option value="Madre">Madre</option><option value="Pareja">Pareja</option><option value="Hermano">Hermano(a)</option></Select></FormField>
                </div>
              </div>

              <div className="rounded-xl border border-slate-200 bg-white p-3">
                <SectionTitle icon={Wallet} title="Datos bancarios" />
                <div className="grid gap-3 md:grid-cols-2">
                  <FormField label="Banco"><Select {...register("bankName")}><option value="">Seleccionar banco</option><option value="BCP">BCP</option><option value="BBVA">BBVA</option><option value="INTERBANK">Interbank</option><option value="SCOTIABANK">Scotiabank</option></Select></FormField>
                  <FormField label="Tipo de cuenta"><Select {...register("bankAccountType")}><option value="">Seleccionar tipo</option><option value="savings">Ahorros</option><option value="checking">Corriente</option></Select></FormField>
                  <FormField label="N? de cuenta"><Input placeholder="N?mero de cuenta" {...register("bankAccountNumber")} /></FormField>
                  <FormField label="CCI (20 d?gitos)" error={errors.bankAccountCci.message}><Input placeholder="C?digo de Cuenta Interbancaria" maxLength={20} {...register("bankAccountCci")} /></FormField>
                  <FormField label="Moneda"><Select {...register("bankCurrency")}><option value="PEN">PEN - Soles</option><option value="USD">USD - D?lares</option></Select></FormField>
                </div>
              </div>
            </div>

            <div className="rounded-xl border border-slate-200 bg-white p-3">
              <FormField label="Observaciones"><Textarea rows={3} {...register("notes")} /></FormField>
            </div>
          </div>

          <div className="flex items-center justify-end gap-2 border-t border-slate-200 bg-white pt-3">
            <Button type="button" variant="secondary" onClick={onClose}>Cancelar</Button>
            <Button type="submit" disabled={saving || loadingEmployee}>{saving  "Guardando..." : "Guardar empleado"}</Button>
          </div>
        </form>
      )}
    </Modal>
  );
}
