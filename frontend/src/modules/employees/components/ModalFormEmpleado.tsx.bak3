import { useEffect } from "react";
import { useForm } from "react-hook-form";
import { z } from "zod";
import { zodResolver } from "@hookform/resolvers/zod";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Select } from "@/components/ui/select";
import { Textarea } from "@/components/ui/textarea";
import { Modal } from "@/components/ui/modal";
import { FormField } from "@/components/forms/FormField";
import type { EmployeeCatalogs, EmployeeDetail, EmployeePayload } from "@/modules/employees/types/employee.types";
 schema = z.object({
  employeeCode: z.string().min(2, "Codigo requerido"),
  firstName: z.string().min(2, "Nombre requerido"),
  lastName: z.string().min(2, "Apellido requerido"),
  documentType: z.string().min(2, "Tipo documento requerido"),
  documentNumber: z.string().min(5, "Documento requerido"),
  birthDate: z.string().min(1, "Fecha de nacimiento requerida"),
  hireDate: z.string().min(1, "Fecha de ingreso requerida"),
  baseSalary: z.coerce.number().min(0, "Sueldo invalido"),
  personalEmail: z.string().email("Correo personal invalido"),
  workEmail: z.string().email("Correo corporativo invalido"),
  phoneNumber: z.string().min(6, "Telefono requerido"),
  profilePhotoUrl: z.string().optional(),
  notes: z.string().optional(),
  emergencyContactName: z.string().optional(),
  emergencyContactPhone: z.string().optional(),
  contractEndDate: z.string().optional(),
  bankName: z.string().optional(),
  bankAccountNumber: z.string().optional(),
  bankAccountCci: z.string().optional().refine(
    (v) => !v || /^\d{20}$/.test(v),
    { message: "El CCI debe tener 20 digitos" }
  ),
  bankAccountType: z.string().optional(),
  bankCurrency: z.string().optional(),
  branchId: z.string().min(1, "Sede requerida"),
  areaId: z.string().min(1, "Area requerida"),
  positionId: z.string().min(1, "Cargo requerido"),
  contractTypeId: z.string().min(1, "Tipo contrato requerido"),
  managerId: z.string().optional()
});
 EmployeeFormValues = z.infer<typeof schema>;
 EmployeeFormModalProps = {
  open: boolean;
  mode: "create" | "edit";
  catalogs: EmployeeCatalogs | undefined;
  employee: EmployeeDetail | null;
  loadingEmployee: boolean;
  saving: boolean;
  onClose: () => void;
  onSubmit: (payload: EmployeePayload) => Promise<void>;
};
 defaultValues: EmployeeFormValues = {
  employeeCode: "",
  firstName: "",
  lastName: "",
  documentType: "DNI",
  documentNumber: "",
  birthDate: "",
  hireDate: "",
  baseSalary: 0,
  personalEmail: "",
  workEmail: "",
  phoneNumber: "",
  profilePhotoUrl: "",
  notes: "",
  emergencyContactName: "",
  emergencyContactPhone: "",
  contractEndDate: "",
  bankName: "",
  bankAccountNumber: "",
  bankAccountCci: "",
  bankAccountType: "",
  bankCurrency: "PEN",
  branchId: "",
  areaId: "",
  positionId: "",
  contractTypeId: "",
  managerId: ""
};
 function ModalFormEmpleado({
  open,
  mode,
  catalogs,
  employee,
  loadingEmployee,
  saving,
  onClose,
  onSubmit
}: EmployeeFormModalProps): JSX.Element {
  const {
    register,
    handleSubmit,
    reset,
    formState: { errors }
  } = useForm<EmployeeFormValues>({
    resolver: zodResolver(schema),
    defaultValues
  });

  useEffect(() => {
    if (!open) {
      return;
    }

    if (mode === "edit" && employee) {
      reset({
        employeeCode: employee.employeeCode,
        firstName: employee.firstName,
        lastName: employee.lastName,
        documentType: employee.documentType,
        documentNumber: employee.documentNumber,
        birthDate: employee.birthDate,
        hireDate: employee.hireDate,
        baseSalary: employee.baseSalary,
        personalEmail: employee.personalEmail,
        workEmail: employee.workEmail,
        phoneNumber: employee.phoneNumber,
        profilePhotoUrl: employee.profilePhotoUrl ? "",
        notes: employee.notes ? "",
        emergencyContactName: employee.emergencyContactName ? "",
        emergencyContactPhone: employee.emergencyContactPhone ? "",
        contractEndDate: employee.contractEndDate ? "",
        bankName: employee.bankName ? "",
        bankAccountNumber: employee.bankAccountNumber ? "",
        bankAccountCci: employee.bankAccountCci ? "",
        bankAccountType: employee.bankAccountType ? "",
        bankCurrency: employee.bankCurrency ? "PEN",
        branchId: employee.branchId,
        areaId: employee.areaId,
        positionId: employee.positionId,
        contractTypeId: employee.contractTypeId,
        managerId: employee.managerId ? ""
      });
      return;
    }

    reset(defaultValues);
  }, [employee, mode, open, reset]);

  const title = mode === "create" ? "Nuevo empleado" : "Editar empleado";

  const submit = handleSubmit(async (values) => {
    const payload: EmployeePayload = {
      employeeCode: values.employeeCode.trim(),
      firstName: values.firstName.trim(),
      lastName: values.lastName.trim(),
      documentType: values.documentType.trim(),
      documentNumber: values.documentNumber.trim(),
      birthDate: values.birthDate,
      hireDate: values.hireDate,
      baseSalary: Number(values.baseSalary),
      personalEmail: values.personalEmail.trim(),
      workEmail: values.workEmail.trim(),
      phoneNumber: values.phoneNumber.trim(),
      profilePhotoUrl: values.profilePhotoUrl.trim() || undefined,
      notes: values.notes.trim() || undefined,
      emergencyContactName: values.emergencyContactName.trim() || undefined,
      emergencyContactPhone: values.emergencyContactPhone.trim() || undefined,
      contractEndDate: values.contractEndDate || undefined,
      bankName: values.bankName.trim() || undefined,
      bankAccountNumber: values.bankAccountNumber.trim() || undefined,
      bankAccountCci: values.bankAccountCci.trim() || undefined,
      bankAccountType: values.bankAccountType || undefined,
      bankCurrency: values.bankCurrency || undefined,
      branchId: values.branchId,
      areaId: values.areaId,
      positionId: values.positionId,
      contractTypeId: values.contractTypeId,
      managerId: values.managerId || undefined
    };

    await onSubmit(payload);
  });

  return (
    <Modal open={open} title={title} onClose={onClose}>
      {mode === "edit" && loadingEmployee ? (
        <div className="py-8 text-sm text-muted">Cargando datos del empleado...</div>
      ) : (
        <form className="space-y-4" onSubmit={submit}>
          <div className="grid gap-4 md:grid-cols-3">
            <FormField label="Codigo" error={errors.employeeCode.message}>
              <Input {...register("employeeCode")} />
            </FormField>
            <FormField label="Nombre" error={errors.firstName.message}>
              <Input {...register("firstName")} />
            </FormField>
            <FormField label="Apellido" error={errors.lastName.message}>
              <Input {...register("lastName")} />
            </FormField>
          </div>

          <div className="grid gap-4 md:grid-cols-3">
            <FormField label="Tipo documento" error={errors.documentType.message}>
              <Input {...register("documentType")} />
            </FormField>
            <FormField label="Documento" error={errors.documentNumber.message}>
              <Input {...register("documentNumber")} />
            </FormField>
            <FormField label="Telefono" error={errors.phoneNumber.message}>
              <Input {...register("phoneNumber")} />
            </FormField>
          </div>

          <div className="grid gap-4 md:grid-cols-3">
            <FormField label="Nacimiento" error={errors.birthDate.message}>
              <Input type="date" {...register("birthDate")} />
            </FormField>
            <FormField label="Ingreso" error={errors.hireDate.message}>
              <Input type="date" {...register("hireDate")} />
            </FormField>
            <FormField label="Sueldo base" error={errors.baseSalary.message}>
              <Input type="number" step="0.01" {...register("baseSalary")} />
            </FormField>
          </div>

          <div className="grid gap-4 md:grid-cols-2">
            <FormField label="Correo corporativo" error={errors.workEmail.message}>
              <Input type="email" {...register("workEmail")} />
            </FormField>
            <FormField label="Correo personal" error={errors.personalEmail.message}>
              <Input type="email" {...register("personalEmail")} />
            </FormField>
          </div>

          <div className="grid gap-4 md:grid-cols-2">
            <FormField label="Sede" error={errors.branchId.message}>
              <Select {...register("branchId")}>
                <option value="">Selecciona sede</option>
                {catalogs.branches.map((item) => (
                  <option key={item.id} value={item.id}>{item.name}</option>
                ))}
              </Select>
            </FormField>
            <FormField label="Area" error={errors.areaId.message}>
              <Select {...register("areaId")}>
                <option value="">Selecciona area</option>
                {catalogs.areas.map((item) => (
                  <option key={item.id} value={item.id}>{item.name}</option>
                ))}
              </Select>
            </FormField>
          </div>

          <div className="grid gap-4 md:grid-cols-2">
            <FormField label="Cargo" error={errors.positionId.message}>
              <Select {...register("positionId")}>
                <option value="">Selecciona cargo</option>
                {catalogs.positions.map((item) => (
                  <option key={item.id} value={item.id}>{item.name}</option>
                ))}
              </Select>
            </FormField>
            <FormField label="Tipo contrato" error={errors.contractTypeId.message}>
              <Select {...register("contractTypeId")}>
                <option value="">Selecciona tipo</option>
                {catalogs.contractTypes.map((item) => (
                  <option key={item.id} value={item.id}>{item.name}</option>
                ))}
              </Select>
            </FormField>
          </div>

          <div className="grid gap-4 md:grid-cols-2">
            <FormField label="Jefe directo" error={errors.managerId.message}>
              <Select {...register("managerId")}>
                <option value="">Sin asignar</option>
                {catalogs.managers.map((item) => (
                  <option key={item.id} value={item.id}>{item.name}</option>
                ))}
              </Select>
            </FormField>
            <FormField label="Foto URL" error={errors.profilePhotoUrl.message}>
              <Input {...register("profilePhotoUrl")} />
            </FormField>
          </div>

          <div className="grid gap-4 md:grid-cols-3">
            <FormField label="Contacto emergencia" error={errors.emergencyContactName.message}>
              <Input {...register("emergencyContactName")} placeholder="Nombre del contacto" />
            </FormField>
            <FormField label="Tel. emergencia" error={errors.emergencyContactPhone.message}>
              <Input {...register("emergencyContactPhone")} placeholder="Telefono del contacto" />
            </FormField>
            <FormField label="Fin de contrato" error={errors.contractEndDate.message}>
              <Input type="date" {...register("contractEndDate")} />
            </FormField>
          </div>

          {/* Datos bancarios */}
          <div className="rounded-xl border border-slate-200 p-4 space-y-3">
            <p className="text-xs font-semibold uppercase tracking-wider text-slate-500">Datos bancarios (pago de haberes)</p>
            <div className="grid gap-4 md:grid-cols-3">
              <FormField label="Banco">
                <Select {...register("bankName")}>
                  <option value="">Sin asignar</option>
                  <option value="BCP">BCP</option>
                  <option value="BBVA">BBVA</option>
                  <option value="INTERBANK">Interbank</option>
                  <option value="SCOTIABANK">Scotiabank</option>
                  <option value="BANBIF">BanBif</option>
                  <option value="PICHINCHA">Banco Pichincha</option>
                  <option value="OTRO">Otro</option>
                </Select>
              </FormField>
              <FormField label="Tipo cuenta">
                <Select {...register("bankAccountType")}>
                  <option value="">Sin asignar</option>
                  <option value="savings">Ahorros</option>
                  <option value="checking">Corriente</option>
                </Select>
              </FormField>
              <FormField label="Moneda">
                <Select {...register("bankCurrency")}>
                  <option value="PEN">PEN â€” Soles</option>
                  <option value="USD">USD â€” Dolares</option>
                </Select>
              </FormField>
            </div>
            <div className="grid gap-4 md:grid-cols-2">
              <FormField label="Nro. cuenta">
                <Input {...register("bankAccountNumber")} placeholder="Numero de cuenta del banco" />
              </FormField>
              <FormField label="CCI (20 digitos)" error={errors.bankAccountCci.message}>
                <Input {...register("bankAccountCci")} placeholder="Codigo de Cuenta Interbancario" maxLength={20} />
              </FormField>
            </div>
          </div>

          <FormField label="Observaciones" error={errors.notes.message}>
            <Textarea {...register("notes")} />
          </FormField>

          <div className="flex justify-end gap-2 pt-2">
            <Button type="button" variant="secondary" onClick={onClose}>
              Cancelar
            </Button>
            <Button type="submit" disabled={saving || loadingEmployee}>
              {saving ? "Guardando..." : mode === "create" ? "Crear empleado" : "Guardar cambios"}
            </Button>
          </div>
        </form>
      )}
    </Modal>
  );
}


