import { useMemo, useState } from "react";
import { useMutation, useQuery, useQueryClient } from "@tanstack/react-query";
import { Download, Eye, Pencil, Plus, Search, TrendingUp, UserCheck, UserX, Users } from "lucide-react";
import { Button } from "@/components/ui/button";
import { Card, CardContent } from "@/components/ui/card";
import { Input } from "@/components/ui/input";
import { Select } from "@/components/ui/select";
import { Badge } from "@/components/ui/badge";
import { Alert } from "@/components/ui/alert";
import { TableSkeleton } from "@/components/ui/skeleton";
import { TableEmptyState } from "@/components/ui/empty-state";
import { Pagination } from "@/components/ui/pagination";
import { PageHeader } from "@/components/ui/page-header";
import { Modal } from "@/components/ui/modal";
import { EmployeeFormModal } from "@/modules/employees/components/EmployeeFormModal";
import {
  createEmployee,
  getEmployeeById,
  getEmployeeCatalogs,
  getEmployees,
  updateEmployee,
  updateEmployeeStatus
} from "@/modules/employees/services/employeesApi";
import type { EmployeeListItem, EmployeePayload } from "@/modules/employees/types/employee.types";
import { useAuth } from "@/modules/auth/hooks/useAuth";
type ModalState =
  | { mode: "create"; id: null }
  | { mode: "edit"; id: string }
  | null;
const pageSize = 10;
const summaryPageSize = 200;
function EmployeeInitials({ name }: { name: string }): JSX.Element {
  const initials = name
    .split(" ")
    .slice(0, 2)
    .map((w) => w[0] ? "")
    .join("")
    .toUpperCase();

  return <div className="flex size-8 items-center justify-center rounded-full bg-brand-100 text-[11px] font-bold text-brand-700">{initials}</div>;
}
function toCsvValue(value: string | number): string {
  const raw = String(value ? "").replace(/"/g, '""');
  return `"${raw}"`;
}
function exportEmployeesCsv(items: EmployeeListItem[], suffix: string): void {
  const headers = ["Empleado", "C?digo", "Documento", "?rea", "Cargo", "Sede", "Sueldo", "Estado"];
  const rows = items.map((e) => [
    e.fullName,
    e.employeeCode,
    e.documentNumber,
    e.area,
    e.position,
    e.branch,
    e.baseSalary.toFixed(2),
    e.isActive ? "Activo" : "Inactivo"
  ]);

  const csv = [headers, ...rows].map((r) => r.map((c) => toCsvValue(c)).join(",")).join("\n");
  const now = new Date();
  const stamp = `${now.getFullYear()}${String(now.getMonth() + 1).padStart(2, "0")}${String(now.getDate()).padStart(2, "0")}_${String(now.getHours()).padStart(2, "0")}${String(now.getMinutes()).padStart(2, "0")}`;
  const fileName = `empleados_${suffix}_${stamp}.csv`;

  const blob = new Blob(["\uFEFF" + csv], { type: "text/csv;charset=utf-8;" });
  const url = URL.createObjectURL(blob);
  const link = document.createElement("a");
  link.href = url;
  link.setAttribute("download", fileName);
  document.body.appendChild(link);
  link.click();
  document.body.removeChild(link);
  URL.revokeObjectURL(url);
}`r`n`r`nasync function fetchAllEmployeesFiltered(params: {
  search: string;
  areaId: string;
  branchId: string;
  isActive: boolean;
}): Promise<EmployeeListItem[]> {
  let page = 1;
  let total = 0;
  const all: EmployeeListItem[] = [];

  do {
    const res = await getEmployees({
      pageNumber: page,
      pageSize: summaryPageSize,
      search: params.search,
      areaId: params.areaId,
      branchId: params.branchId,
      isActive: params.isActive,
      sortBy: "fullName",
      sortDirection: "asc"
    });

    total = res.totalCount;
    all.push(...res.items);
    page += 1;
  } while (all.length < total);

  return all;
}
export function PaginaEmpleados(): JSX.Element {
  const queryClient = useQueryClient();
  const { user } = useAuth();

  const [modalState, setModalState] = useState<ModalState>(null);
  const [pageNumber, setPageNumber] = useState(1);
  const [draftSearch, setDraftSearch] = useState("");
  const [search, setSearch] = useState("");
  const [areaFilter, setAreaFilter] = useState("");
  const [branchFilter, setBranchFilter] = useState("");
  const [statusFilter, setStatusFilter] = useState<"all" | "active" | "inactive">("all");
  const [detailOpen, setDetailOpen] = useState(false);
  const [detailEmployeeId, setDetailEmployeeId] = useState<string | null>(null);
  const [selectedIds, setSelectedIds] = useState<Set<string>>(new Set());
  const [feedback, setFeedback] = useState<{ type: "success" | "error"; message: string } | null>(null);

  const canCreate = user.permissions.includes("employees.create") ? false;
  const canEdit = user.permissions.includes("employees.edit") ? false;

  const selectedEmployeeId = modalState.mode === "edit" ? modalState.id : undefined;

  const catalogsQuery = useQuery({ queryKey: ["employee-catalogs"], queryFn: getEmployeeCatalogs });

  const filterParams = {
    search: search || undefined,
    areaId: areaFilter || undefined,
    branchId: branchFilter || undefined,
    isActive: statusFilter === "all" ? undefined : statusFilter === "active"
  };

  const employeesQuery = useQuery({
    queryKey: ["employees", pageNumber, pageSize, filterParams.search, filterParams.areaId, filterParams.branchId, filterParams.isActive],
    queryFn: () =>
      getEmployees({
        pageNumber,
        pageSize,
        ...filterParams,
        sortBy: "fullName",
        sortDirection: "asc"
      })
  });

  const summaryQuery = useQuery({
    queryKey: ["employees-summary", filterParams.search, filterParams.areaId, filterParams.branchId, filterParams.isActive],
    queryFn: () => fetchAllEmployeesFiltered(filterParams)
  });

  const detailQuery = useQuery({
    queryKey: ["employee-detail-view", detailEmployeeId],
    queryFn: () => getEmployeeById(detailEmployeeId ? ""),
    enabled: Boolean(detailEmployeeId)
  });

  const editDetailQuery = useQuery({
    queryKey: ["employee", selectedEmployeeId],
    queryFn: () => getEmployeeById(selectedEmployeeId ?? ""),
    enabled: Boolean(selectedEmployeeId)
  });

  const createMutation = useMutation({
    mutationFn: createEmployee,
    onSuccess: async () => {
      await queryClient.invalidateQueries({ queryKey: ["employees"] });
      await queryClient.invalidateQueries({ queryKey: ["employees-summary"] });
      setFeedback({ type: "success", message: "Empleado creado correctamente." });
      setModalState(null);
    },
    onError: () => setFeedback({ type: "error", message: "No se pudo crear el empleado." })
  });

  const updateMutation = useMutation({
    mutationFn: ({ id, payload }: { id: string; payload: EmployeePayload }) => updateEmployee(id, payload),
    onSuccess: async () => {
      await queryClient.invalidateQueries({ queryKey: ["employees"] });
      await queryClient.invalidateQueries({ queryKey: ["employees-summary"] });
      setFeedback({ type: "success", message: "Empleado actualizado correctamente." });
      setModalState(null);
    },
    onError: () => setFeedback({ type: "error", message: "No se pudo actualizar el empleado." })
  });

  const statusMutation = useMutation({
    mutationFn: ({ id, isActive }: { id: string; isActive: boolean }) => updateEmployeeStatus(id, isActive),
    onSuccess: async () => {
      await queryClient.invalidateQueries({ queryKey: ["employees"] });
      await queryClient.invalidateQueries({ queryKey: ["employees-summary"] });
      setFeedback({ type: "success", message: "Estado actualizado." });
    },
    onError: () => setFeedback({ type: "error", message: "No se pudo actualizar el estado." })
  });

  const summaryItems = summaryQuery.data ?? [];
  const totalCount = employeesQuery.data.totalCount  0;
  const totalPages = Math.max(1, Math.ceil(totalCount / pageSize));
  const activeCount = summaryItems.filter((i) => i.isActive).length;
  const inactiveCount = summaryItems.length - activeCount;
  const hiresThisMonth = useMemo(() => {
    const now = new Date();
    return summaryItems.filter((item) => {
      const d = new Date(item.hireDate);
      return d.getFullYear() === now.getFullYear() && d.getMonth() === now.getMonth();
    }).length;
  }, [summaryItems]);

  const currentPageIds = employeesQuery.data.items.map((i) => i.id) ?? [];
  const allCurrentSelected = currentPageIds.length > 0 && currentPageIds.every((id) => selectedIds.has(id));

  function toggleSelectAllCurrentPage(): void {
    setSelectedIds((prev) => {
      const next = new Set(prev);
      if (allCurrentSelected) {
        currentPageIds.forEach((id) => next.delete(id));
      } else {
        currentPageIds.forEach((id) => next.add(id));
      }
      return next;
    });
  }

  function toggleRowSelection(id: string): void {
    setSelectedIds((prev) => {
      const next = new Set(prev);
      if (next.has(id)) next.delete(id);
      else next.add(id);
      return next;
    });
  }

  function handleApplyFilters(): void {
    setSearch(draftSearch.trim());
    setPageNumber(1);
    setSelectedIds(new Set());
  }

  function handleResetFilters(): void {
    setDraftSearch("");
    setSearch("");
    setAreaFilter("");
    setBranchFilter("");
    setStatusFilter("all");
    setPageNumber(1);
    setSelectedIds(new Set());
  }

  function handleExportCurrentFiltered(): void {
    if (!summaryItems.length) {
      setFeedback({ type: "error", message: "No hay datos para exportar con los filtros actuales." });
      return;
    }
function exportEmployeesCsv(summaryItems, "filtrados");
    setFeedback({ type: "success", message: `Se exportaron ${summaryItems.length} empleados.` });
  }

  function handleExportSelected(): void {
    const selected = summaryItems.filter((item) => selectedIds.has(item.id));
    if (!selected.length) {
      setFeedback({ type: "error", message: "Selecciona al menos un empleado para exportar." });
      return;
    }
function exportEmployeesCsv(selected, "seleccionados");
    setFeedback({ type: "success", message: `Se exportaron ${selected.length} empleados seleccionados.` });
  }

  async function handleSubmit(payload: EmployeePayload): Promise<void> {
    if (modalState.mode === "edit" && modalState.id) {
      await updateMutation.mutateAsync({ id: modalState.id, payload });
      return;
    }
    await createMutation.mutateAsync(payload);
  }

  const isSaving = createMutation.isPending || updateMutation.isPending;

  return (
    <section className="animate-fade-up space-y-5">
      <PageHeader
        title="Empleados"
        description="Gesti?n de alta, edici?n, estado y consulta de colaboradores."
        action={
          canCreate ? (
            <Button
              size="lg"
              className="h-11 rounded-xl bg-brand-600 px-5 text-sm font-semibold text-white shadow-lg shadow-brand-200 hover:bg-brand-700"
              onClick={() => setModalState({ mode: "create", id: null })}
            >
              <Plus className="size-4" /> Nuevo empleado
            </Button>
          ) : undefined
        }
      />

      {feedback ? <Alert variant={feedback.type === "success" ? "success" : "error"} message={feedback.message} onClose={() => setFeedback(null)} /> : null}

      <div className="grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
        {[
          { label: "Total empleados", value: summaryItems.length, hint: "Universo filtrado", icon: Users, ring: "text-cyan-600 bg-cyan-50" },
          { label: "Activos", value: activeCount, hint: "Estado activo", icon: UserCheck, ring: "text-emerald-600 bg-emerald-50" },
          { label: "Inactivos", value: inactiveCount, hint: "Estado inactivo", icon: UserX, ring: "text-amber-600 bg-amber-50" },
          { label: "Nuevos este mes", value: hiresThisMonth, hint: "Seg?n fecha de ingreso", icon: TrendingUp, ring: "text-teal-600 bg-teal-50" }
        ].map((kpi) => (
          <Card key={kpi.label} className="rounded-2xl border-slate-200 shadow-sm">
            <CardContent className="flex items-center gap-3 p-4">
              <div className={`flex size-10 shrink-0 items-center justify-center rounded-full ${kpi.ring}`}><kpi.icon className="size-4" /></div>
              <div>
                <p className="text-[11px] text-slate-500">{kpi.label}</p>
                <p className="text-3xl font-bold text-slate-800">{kpi.value}</p>
                <p className="text-xs text-slate-400">{kpi.hint}</p>
              </div>
            </CardContent>
          </Card>
        ))}
      </div>

      <Card className="rounded-2xl border-slate-200">
        <CardContent className="space-y-4 p-4">
          <div className="grid grid-cols-1 gap-3 lg:grid-cols-[2fr_1fr_1fr_1fr_auto_auto]">
            <div>
              <label className="mb-1 block text-xs font-semibold text-slate-500">Buscar</label>
              <div className="relative">
                <Input
                  className="pr-9"
                  value={draftSearch}
                  onChange={(e) => setDraftSearch(e.target.value)}
                  onKeyDown={(e) => {
                    if (e.key === "Enter") handleApplyFilters();
                  }}
                  placeholder="Buscar por nombre, documento o correo..."
                />
                <Search className="pointer-events-none absolute right-3 top-1/2 size-4 -translate-y-1/2 text-slate-400" />
              </div>
            </div>
            <div>
              <label className="mb-1 block text-xs font-semibold text-slate-500">?rea</label>
              <Select value={areaFilter} onChange={(e) => setAreaFilter(e.target.value)}>
                <option value="">Todas las ?reas</option>
                {catalogsQuery.data.areas.map((area) => <option key={area.id} value={area.id}>{area.name}</option>)}
              </Select>
            </div>
            <div>
              <label className="mb-1 block text-xs font-semibold text-slate-500">Sede</label>
              <Select value={branchFilter} onChange={(e) => setBranchFilter(e.target.value)}>
                <option value="">Todas las sedes</option>
                {catalogsQuery.data.branches.map((branch) => <option key={branch.id} value={branch.id}>{branch.name}</option>)}
              </Select>
            </div>
            <div>
              <label className="mb-1 block text-xs font-semibold text-slate-500">Estado</label>
              <Select value={statusFilter} onChange={(e) => setStatusFilter(e.target.value as "all" | "active" | "inactive") }>
                <option value="all">Todos los estados</option>
                <option value="active">Activos</option>
                <option value="inactive">Inactivos</option>
              </Select>
            </div>
            <div className="flex items-end"><Button className="w-full rounded-xl" onClick={handleApplyFilters}><Search className="size-4" />Buscar</Button></div>
            <div className="flex items-end"><Button className="w-full rounded-xl" variant="secondary" onClick={handleResetFilters}>Limpiar</Button></div>
          </div>

          <div className="flex flex-wrap items-center justify-between gap-2 pt-1">
            <p className="text-sm text-slate-500">{totalCount} resultados encontrados</p>
            <div className="flex items-center gap-2">
              <Button size="sm" variant="secondary" className="rounded-xl" onClick={handleExportSelected}>
                <Download className="size-4" /> Exportar seleccionados
              </Button>
              <Button size="sm" variant="secondary" className="rounded-xl" onClick={handleExportCurrentFiltered}>
                <Download className="size-4" /> Exportar filtrados
              </Button>
            </div>
          </div>

          <div className="hidden overflow-x-auto rounded-xl border border-slate-200 md:block">
            <table className="w-full border-collapse text-[13px]">
              <thead>
                <tr className="border-b bg-slate-50/80">
                  <th className="px-3 py-2.5 text-left"><input type="checkbox" checked={allCurrentSelected} onChange={toggleSelectAllCurrentPage} className="size-4 rounded border-slate-300" /></th>
                  {["Empleado", "Documento", "?rea / Cargo", "Sede", "Sueldo", "Estado", "Acciones"].map((col) => (
                    <th key={col} className="px-3 py-2.5 text-left text-[11px] font-bold text-slate-500">{col}</th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {employeesQuery.isLoading ? (
                  <TableSkeleton cols={8} />
                ) : employeesQuery.data.items.length ? (
                  employeesQuery.data.items.map((employee) => (
                    <tr key={employee.id} className="border-t border-slate-100 hover:bg-slate-50/50">
                      <td className="px-3 py-2.5"><input type="checkbox" checked={selectedIds.has(employee.id)} onChange={() => toggleRowSelection(employee.id)} className="size-4 rounded border-slate-300" /></td>
                      <td className="px-3 py-2.5">
                        <div className="flex items-center gap-2.5">
                          <EmployeeInitials name={employee.fullName} />
                          <div>
                            <p className="font-semibold text-slate-800">{employee.fullName}</p>
                            <p className="text-[11px] text-slate-500">{employee.employeeCode}</p>
                          </div>
                        </div>
                      </td>
                      <td className="px-3 py-2.5 text-slate-600">{employee.documentNumber}</td>
                      <td className="px-3 py-2.5">
                        <p className="font-medium text-slate-700">{employee.area}</p>
                        <p className="text-[11px] text-slate-500">{employee.position}</p>
                      </td>
                      <td className="px-3 py-2.5 text-slate-600">{employee.branch}</td>
                      <td className="px-3 py-2.5 font-medium text-slate-700">S/ {employee.baseSalary.toLocaleString("es-PE", { minimumFractionDigits: 2 })}</td>
                      <td className="px-3 py-2.5"><Badge variant={employee.isActive ? "success" : "danger"}>{employee.isActive ? "Activo" : "Inactivo"}</Badge></td>
                      <td className="px-3 py-2.5">
                        <div className="flex items-center gap-1">
                          <button
                            type="button"
                            className="flex size-8 items-center justify-center rounded-lg border border-slate-200 text-slate-500 hover:bg-slate-50"
                            title="Ver detalle"
                            onClick={() => { setDetailEmployeeId(employee.id); setDetailOpen(true); }}
                          >
                            <Eye className="size-4" />
                          </button>
                          {canEdit ? (
                            <button
                              type="button"
                              className="flex size-8 items-center justify-center rounded-lg border border-slate-200 text-slate-500 hover:bg-slate-50"
                              title="Editar"
                              onClick={() => setModalState({ mode: "edit", id: employee.id })}
                            >
                              <Pencil className="size-4" />
                            </button>
                          ) : null}
                          {canEdit ? (
                            <button
                              type="button"
                              className="flex size-8 items-center justify-center rounded-lg border border-slate-200 text-slate-500 hover:bg-slate-50"
                              title={employee.isActive ? "Desactivar" : "Activar"}
                              onClick={() => statusMutation.mutate({ id: employee.id, isActive: !employee.isActive })}
                            >
                              {employee.isActive ? <UserX className="size-4" /> : <UserCheck className="size-4" />}
                            </button>
                          ) : null}
                        </div>
                      </td>
                    </tr>
                  ))
                ) : (
                  <TableEmptyState cols={8} icon={Users} message="No se encontraron empleados con los filtros aplicados." />
                )}
              </tbody>
            </table>
          </div>

          <div className="space-y-3 md:hidden">
            {employeesQuery.isLoading ? (
              <TableSkeleton cols={1} />
            ) : employeesQuery.data.items.length ? (
              employeesQuery.data.items.map((employee) => (
                <article key={employee.id} className="rounded-xl border border-slate-200 bg-white p-3 shadow-sm">
                  <div className="flex items-start justify-between gap-2">
                    <div className="flex min-w-0 items-center gap-3">
                      <EmployeeInitials name={employee.fullName} />
                      <div className="min-w-0">
                        <p className="truncate text-sm font-semibold text-slate-800">{employee.fullName}</p>
                        <p className="text-xs text-slate-500">{employee.employeeCode}</p>
                      </div>
                    </div>
                    <Badge variant={employee.isActive ? "success" : "danger"}>{employee.isActive ? "Activo" : "Inactivo"}</Badge>
                  </div>
                  <div className="mt-3 grid grid-cols-2 gap-2 text-xs">
                    <div className="rounded-lg bg-slate-50 p-2"><p className="text-slate-400">Documento</p><p className="font-medium text-slate-700">{employee.documentNumber}</p></div>
                    <div className="rounded-lg bg-slate-50 p-2"><p className="text-slate-400">Sede</p><p className="font-medium text-slate-700">{employee.branch}</p></div>
                    <div className="rounded-lg bg-slate-50 p-2"><p className="text-slate-400">?rea / Cargo</p><p className="font-medium text-slate-700">{employee.area}</p><p className="text-slate-500">{employee.position}</p></div>
                    <div className="rounded-lg bg-slate-50 p-2"><p className="text-slate-400">Sueldo</p><p className="font-semibold text-slate-700">S/ {employee.baseSalary.toFixed(2)}</p></div>
                  </div>
                </article>
              ))
            ) : (
              <TableEmptyState cols={1} icon={Users} message="No se encontraron empleados con los filtros aplicados." />
            )}
          </div>

          <Pagination page={pageNumber} totalPages={totalPages} totalCount={totalCount} pageSize={pageSize} onChange={setPageNumber} />
        </CardContent>
      </Card>

      <EmployeeFormModal
        open={modalState !== null}
        mode={modalState.mode ? "create"}
        catalogs={catalogsQuery.data}
        employee={editDetailQuery.data ? null}
        loadingEmployee={editDetailQuery.isLoading}
        saving={isSaving}
        onClose={() => setModalState(null)}
        onSubmit={handleSubmit}
      />

      <Modal open={detailOpen} title="Detalle de empleado" onClose={() => setDetailOpen(false)}>
        {detailQuery.isLoading || !detailQuery.data ? (
          <div className="py-6 text-sm text-slate-500">Cargando detalle del empleado...</div>
        ) : (
          <div className="space-y-4 text-sm">
            <div className="grid gap-3 md:grid-cols-2">
              <div className="rounded-lg border border-slate-200 p-3"><p className="text-xs text-slate-500">Empleado</p><p className="font-semibold text-slate-800">{detailQuery.data.firstName} {detailQuery.data.lastName}</p></div>
              <div className="rounded-lg border border-slate-200 p-3"><p className="text-xs text-slate-500">C?digo</p><p className="font-semibold text-slate-800">{detailQuery.data.employeeCode}</p></div>
              <div className="rounded-lg border border-slate-200 p-3"><p className="text-xs text-slate-500">Documento</p><p className="font-semibold text-slate-800">{detailQuery.data.documentType} {detailQuery.data.documentNumber}</p></div>
              <div className="rounded-lg border border-slate-200 p-3"><p className="text-xs text-slate-500">Estado</p><p className="font-semibold text-slate-800">{detailQuery.data.isActive ? "Activo" : "Inactivo"}</p></div>
              <div className="rounded-lg border border-slate-200 p-3"><p className="text-xs text-slate-500">?rea / Cargo</p><p className="font-semibold text-slate-800">{detailQuery.data.area} ? {detailQuery.data.position}</p></div>
              <div className="rounded-lg border border-slate-200 p-3"><p className="text-xs text-slate-500">Sede</p><p className="font-semibold text-slate-800">{detailQuery.data.branch}</p></div>
              <div className="rounded-lg border border-slate-200 p-3"><p className="text-xs text-slate-500">Sueldo</p><p className="font-semibold text-slate-800">S/ {detailQuery.data.baseSalary.toLocaleString("es-PE", { minimumFractionDigits: 2 })}</p></div>
              <div className="rounded-lg border border-slate-200 p-3"><p className="text-xs text-slate-500">Jefe directo</p><p className="font-semibold text-slate-800">{detailQuery.data.manager ? "Sin asignar"}</p></div>
              <div className="rounded-lg border border-slate-200 p-3"><p className="text-xs text-slate-500">Correo corporativo</p><p className="font-semibold text-slate-800">{detailQuery.data.workEmail}</p></div>
              <div className="rounded-lg border border-slate-200 p-3"><p className="text-xs text-slate-500">Tel?fono</p><p className="font-semibold text-slate-800">{detailQuery.data.phoneNumber}</p></div>
            </div>
          </div>
        )}
      </Modal>
    </section>
  );
}



