import { useMemo, useState } from "react";
import { useMutation, useQuery, useQueryClient } from "@tanstack/react-query";
import { Pencil, Plus, Trash2, UserCheck, UserX, Users } from "lucide-react";
import { Button } from "@/components/ui/button";
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
import { Input } from "@/components/ui/input";
import { Select } from "@/components/ui/select";
import { Badge } from "@/components/ui/badge";
import { Alert } from "@/components/ui/alert";
import { TableSkeleton } from "@/components/ui/skeleton";
import { TableEmptyState } from "@/components/ui/empty-state";
import { Pagination } from "@/components/ui/pagination";
import { PageHeader } from "@/components/ui/page-header";
import { EmployeeFormModal } from "@/modules/employees/components/EmployeeFormModal";
import {
  createEmployee,
  deleteEmployee,
  getEmployeeById,
  getEmployeeCatalogs,
  getEmployees,
  updateEmployee,
  updateEmployeeStatus
} from "@/modules/employees/services/employeesApi";
import type { EmployeePayload } from "@/modules/employees/types/employee.types";
import { useAuth } from "@/modules/auth/hooks/useAuth";
 ModalState =
  | { mode: "create"; id: null }
  | { mode: "edit"; id: string }
  | null;
 pageSize = 10;
 EmployeeInitials({ name }: { name: string }): JSX.Element {
  const initials = name
    .split(" ")
    .slice(0, 2)
    .map((w) => w[0] ? "")
    .join("")
    .toUpperCase();
  return (
    <div className="flex size-8 shrink-0 items-center justify-center rounded-lg bg-brand-100 text-[11px] font-bold text-brand-700">
      {initials}
    </div>
  );
}
 function EmployeesPage(): JSX.Element {
  const queryClient = useQueryClient();
  const { user } = useAuth();

  const [modalState, setModalState] = useState<ModalState>(null);
  const [pageNumber, setPageNumber] = useState(1);
  const [draftSearch, setDraftSearch] = useState("");
  const [search, setSearch] = useState("");
  const [areaFilter, setAreaFilter] = useState("");
  const [statusFilter, setStatusFilter] = useState<"all" | "active" | "inactive">("all");
  const [feedback, setFeedback] = useState<{ type: "success" | "error"; message: string } | null>(null);

  const canCreate = user.permissions.includes("employees.create") ? false;
  const canEdit = user.permissions.includes("employees.edit") ? false;
  const canDelete = user.permissions.includes("employees.delete") ? false;
  const selectedEmployeeId = modalState.mode === "edit" ? modalState.id : undefined;

  const catalogsQuery = useQuery({
    queryKey: ["employee-catalogs"],
    queryFn: getEmployeeCatalogs
  });

  const employeesQuery = useQuery({
    queryKey: ["employees", pageNumber, pageSize, search, areaFilter, statusFilter],
    queryFn: () =>
      getEmployees({
        pageNumber,
        pageSize,
        search: search || undefined,
        areaId: areaFilter || undefined,
        isActive: statusFilter === "all" ? undefined : statusFilter === "active",
        sortBy: "fullName",
        sortDirection: "asc"
      })
  });

  const detailQuery = useQuery({
    queryKey: ["employee", selectedEmployeeId],
    queryFn: () => getEmployeeById(selectedEmployeeId ? ""),
    enabled: Boolean(selectedEmployeeId)
  });

  const createMutation = useMutation({
    mutationFn: createEmployee,
    onSuccess: async () => {
      await queryClient.invalidateQueries({ queryKey: ["employees"] });
      await queryClient.invalidateQueries({ queryKey: ["employee-catalogs"] });
      setFeedback({ type: "success", message: "Empleado creado correctamente." });
      setModalState(null);
    },
    onError: () => {
      setFeedback({ type: "error", message: "No se pudo crear el empleado." });
    }
  });

  const updateMutation = useMutation({
    mutationFn: ({ id, payload }: { id: string; payload: EmployeePayload }) => updateEmployee(id, payload),
    onSuccess: async () => {
      await queryClient.invalidateQueries({ queryKey: ["employees"] });
      setFeedback({ type: "success", message: "Empleado actualizado correctamente." });
      setModalState(null);
    },
    onError: () => {
      setFeedback({ type: "error", message: "No se pudo actualizar el empleado." });
    }
  });

  const statusMutation = useMutation({
    mutationFn: ({ id, isActive }: { id: string; isActive: boolean }) => updateEmployeeStatus(id, isActive),
    onSuccess: async () => {
      await queryClient.invalidateQueries({ queryKey: ["employees"] });
      setFeedback({ type: "success", message: "Estado actualizado." });
    },
    onError: () => {
      setFeedback({ type: "error", message: "No se pudo actualizar el estado." });
    }
  });

  const deleteMutation = useMutation({
    mutationFn: deleteEmployee,
    onSuccess: async () => {
      await queryClient.invalidateQueries({ queryKey: ["employees"] });
      setFeedback({ type: "success", message: "Empleado eliminado correctamente." });
    },
    onError: () => {
      setFeedback({ type: "error", message: "No se pudo eliminar el empleado." });
    }
  });

  const totalPages = useMemo(() => {
    const totalCount = employeesQuery.data.totalCount  0;
    return Math.max(1, Math.ceil(totalCount / pageSize));
  }, [employeesQuery.data.totalCount]);

  const isSaving = createMutation.isPending || updateMutation.isPending;

  function handleApplyFilters(): void {
    setSearch(draftSearch.trim());
    setPageNumber(1);
  }

  async function handleSubmit(payload: EmployeePayload): Promise<void> {
    if (modalState.mode === "edit" && modalState.id) {
      await updateMutation.mutateAsync({ id: modalState.id, payload });
      return;
    }
    await createMutation.mutateAsync(payload);
  }

  return (
    <section className="animate-fade-up space-y-5">
      <PageHeader
        title="Empleados"
        description="GestiÃ³n de alta, ediciÃ³n, estado y consulta de colaboradores."
        action={
          canCreate ? (
            <Button
              size="lg"
              className="btn-create"
              onClick={() => setModalState({ mode: "create", id: null })}
            >
              <Plus className="size-4" /> Nuevo empleado
            </Button>
          ) : undefined
        }
      />

      {feedback ? (
        <Alert
          variant={feedback.type === "success" ? "success" : "error"}
          message={feedback.message}
          onClose={() => setFeedback(null)}
        />
      ) : null}

      {/* Table with filters */}
      <Card>
        <CardHeader className="flex flex-col gap-3">
          <div className="flex items-center justify-between gap-3">
            <CardTitle>Listado de empleados</CardTitle>
            {employeesQuery.data.totalCount ? (
              <span className="rounded-full bg-slate-100 px-2.5 py-0.5 text-[11px] font-semibold text-slate-600">
                {employeesQuery.data.totalCount} registros
              </span>
            ) : null}
          </div>

          <div className="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-[2fr_1fr_1fr_auto]">
            <div>
              <label className="mb-1 block text-[10px] font-semibold uppercase tracking-wide text-slate-500">Buscar</label>
              <Input
                value={draftSearch}
                onChange={(e) => setDraftSearch(e.target.value)}
                onKeyDown={(e) => { if (e.key === "Enter") handleApplyFilters(); }}
                placeholder="Buscar nombre, documento o correo..."
              />
            </div>
            <div>
              <label className="mb-1 block text-[10px] font-semibold uppercase tracking-wide text-slate-500">Ãrea</label>
              <Select value={areaFilter} onChange={(e) => { setAreaFilter(e.target.value); setPageNumber(1); }}>
                <option value="">Todas las Ã¡reas</option>
                {catalogsQuery.data.areas.map((area) => (
                  <option key={area.id} value={area.id}>{area.name}</option>
                ))}
              </Select>
            </div>
            <div>
              <label className="mb-1 block text-[10px] font-semibold uppercase tracking-wide text-slate-500">Estado</label>
              <Select value={statusFilter} onChange={(e) => { setStatusFilter(e.target.value as "all" | "active" | "inactive"); setPageNumber(1); }}>
                <option value="all">Todos los estados</option>
                <option value="active">Activos</option>
                <option value="inactive">Inactivos</option>
              </Select>
            </div>
            <div className="flex items-end">
              <Button className="w-full sm:w-auto" variant="secondary" onClick={handleApplyFilters}>Buscar</Button>
            </div>
          </div>
        </CardHeader>

        <CardContent className="p-0 pb-4">
          <div className="space-y-3 px-3 pb-1 pt-2 md:hidden">
            {employeesQuery.isLoading ? (
              <TableSkeleton cols={1} />
            ) : employeesQuery.data.items.length ? (
              employeesQuery.data.items.map((employee) => (
                <article key={employee.id} className="rounded-xl border border-slate-200 bg-white p-3 shadow-sm">
                  <div className="flex items-start justify-between gap-2">
                    <div className="flex min-w-0 items-center gap-3">
                      <EmployeeInitials name={employee.fullName} />
                      <div className="min-w-0">
                        <p className="truncate text-sm font-semibold text-slate-800">{employee.fullName}</p>
                        <p className="text-xs text-slate-500">{employee.employeeCode}</p>
                      </div>
                    </div>
                    <Badge variant={employee.isActive ? "success" : "danger"}>
                      {employee.isActive ? "Activo" : "Inactivo"}
                    </Badge>
                  </div>
                  <div className="mt-3 grid grid-cols-2 gap-2 text-xs">
                    <div className="rounded-lg bg-slate-50 p-2">
                      <p className="text-slate-400">Documento</p>
                      <p className="font-medium text-slate-700">{employee.documentNumber}</p>
                    </div>
                    <div className="rounded-lg bg-slate-50 p-2">
                      <p className="text-slate-400">Sede</p>
                      <p className="font-medium text-slate-700">{employee.branch}</p>
                    </div>
                    <div className="rounded-lg bg-slate-50 p-2">
                      <p className="text-slate-400">Area / Cargo</p>
                      <p className="font-medium text-slate-700">{employee.area}</p>
                      <p className="text-slate-500">{employee.position}</p>
                    </div>
                    <div className="rounded-lg bg-slate-50 p-2">
                      <p className="text-slate-400">Sueldo</p>
                      <p className="font-semibold text-slate-700">S/ {employee.baseSalary.toFixed(2)}</p>
                    </div>
                  </div>
                  <div className="mt-3 grid grid-cols-3 gap-2">
                    {canEdit ? (
                      <Button size="sm" variant="secondary" onClick={() => setModalState({ mode: "edit", id: employee.id })}>
                        <Pencil className="size-3.5" /> Editar
                      </Button>
                    ) : null}
                    {canEdit ? (
                      <Button
                        size="sm"
                        variant={employee.isActive ? "danger" : "primary"}
                        onClick={() => statusMutation.mutate({ id: employee.id, isActive: !employee.isActive })}
                      >
                        {employee.isActive ? <UserX className="size-3.5" /> : <UserCheck className="size-3.5" />}
                        {employee.isActive ? "Desact." : "Activar"}
                      </Button>
                    ) : null}
                    {canDelete ? (
                      <Button
                        size="sm"
                        variant="ghost"
                        className="text-rose-600 hover:bg-rose-50 hover:text-rose-700"
                        onClick={() => {
                          if (!window.confirm("Â¿Eliminar este empleado Esta acciÃ³n es lÃ³gica y reversible.")) return;
                          deleteMutation.mutate(employee.id);
                        }}
                      >
                        <Trash2 className="size-3.5" /> Eliminar
                      </Button>
                    ) : null}
                  </div>
                </article>
              ))
            ) : (
              <TableEmptyState cols={1} icon={Users} message="No se encontraron empleados con los filtros aplicados." />
            )}
          </div>

          <div className="hidden overflow-x-auto md:block">
            <table className="w-full border-collapse text-[13px]">
              <thead>
                <tr className="border-b bg-slate-50">
                  {["Empleado", "Documento", "Ãrea / Cargo", "Sede", "Sueldo", "Estado", ""].map((col) => (
                    <th
                      key={col}
                      className="px-4 py-2.5 text-left text-[11px] font-bold uppercase tracking-wide text-slate-400 last:text-right"
                    >
                      {col}
                    </th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {employeesQuery.isLoading ? (
                  <TableSkeleton cols={7} />
                ) : employeesQuery.data.items.length ? (
                  employeesQuery.data.items.map((employee) => (
                    <tr key={employee.id} className="border-t transition-colors hover:bg-slate-50/70">
                      <td className="px-4 py-3">
                        <div className="flex items-center gap-3">
                          <EmployeeInitials name={employee.fullName} />
                          <div>
                            <p className="font-semibold text-slate-800">{employee.fullName}</p>
                            <p className="text-[11px] text-muted">{employee.employeeCode}</p>
                          </div>
                        </div>
                      </td>
                      <td className="px-4 py-3 text-slate-600">{employee.documentNumber}</td>
                      <td className="px-4 py-3">
                        <p className="font-medium text-slate-700">{employee.area}</p>
                        <p className="text-[11px] text-muted">{employee.position}</p>
                      </td>
                      <td className="px-4 py-3 text-slate-600">{employee.branch}</td>
                      <td className="px-4 py-3 font-medium text-slate-700">
                        S/ {employee.baseSalary.toFixed(2)}
                      </td>
                      <td className="px-4 py-3">
                        <Badge variant={employee.isActive ? "success" : "danger"}>
                          {employee.isActive ? "Activo" : "Inactivo"}
                        </Badge>
                      </td>
                      <td className="px-4 py-3">
                        <div className="flex justify-end gap-0.5">
                          {canEdit ? (
                            <button
                              className="flex size-8 items-center justify-center rounded-lg text-slate-400 transition hover:bg-slate-100 hover:text-slate-600"
                              title="Editar"
                              onClick={() => setModalState({ mode: "edit", id: employee.id })}
                            >
                              <Pencil className="size-3.5" />
                            </button>
                          ) : null}
                          {canEdit ? (
                            <button
                              className="flex size-8 items-center justify-center rounded-lg text-slate-400 transition hover:bg-slate-100 hover:text-slate-600"
                              title={employee.isActive ? "Desactivar" : "Activar"}
                              onClick={() => statusMutation.mutate({ id: employee.id, isActive: !employee.isActive })}
                            >
                              {employee.isActive ? <UserX className="size-3.5" /> : <UserCheck className="size-3.5" />}
                            </button>
                          ) : null}
                          {canDelete ? (
                            <button
                              className="flex size-8 items-center justify-center rounded-lg text-slate-400 transition hover:bg-rose-50 hover:text-rose-500"
                              title="Eliminar"
                              onClick={() => {
                                if (!window.confirm("Â¿Eliminar este empleado Esta acciÃ³n es lÃ³gica y reversible.")) return;
                                deleteMutation.mutate(employee.id);
                              }}
                            >
                              <Trash2 className="size-3.5" />
                            </button>
                          ) : null}
                        </div>
                      </td>
                    </tr>
                  ))
                ) : (
                  <TableEmptyState cols={7} icon={Users} message="No se encontraron empleados con los filtros aplicados." />
                )}
              </tbody>
            </table>
          </div>

          <div className="px-4">
            <Pagination
              page={pageNumber}
              totalPages={totalPages}
              totalCount={employeesQuery.data.totalCount  0}
              pageSize={pageSize}
              onChange={setPageNumber}
            />
          </div>
        </CardContent>
      </Card>

      <EmployeeFormModal
        open={modalState !== null}
        mode={modalState.mode ? "create"}
        catalogs={catalogsQuery.data}
        employee={detailQuery.data ? null}
        loadingEmployee={detailQuery.isLoading}
        saving={isSaving}
        onClose={() => setModalState(null)}
        onSubmit={handleSubmit}
      />
    </section>
  );
}




