import { useMemo, useState } from "react";
import { useMutation, useQuery, useQueryClient } from "@tanstack/react-query";
import { Cog, Edit, Pencil, Plus, Trash2, UserCheck, UserX } from "lucide-react";
import { useAuth } from "@/modules/auth/hooks/useAuth";
import { Badge } from "@/components/ui/badge";
import { Button } from "@/components/ui/button";
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
import { Input } from "@/components/ui/input";
import { Select } from "@/components/ui/select";
import { Alert } from "@/components/ui/alert";
import { TableSkeleton } from "@/components/ui/skeleton";
import { TableEmptyState } from "@/components/ui/empty-state";
import { Pagination } from "@/components/ui/pagination";
import { PageHeader } from "@/components/ui/page-header";
import { ConfirmModal } from "@/components/modals/ConfirmModal";
import { ConfigurationCatalogFormModal } from "@/modules/configuration/components/ConfigurationCatalogFormModal";
import { GeneralSettingFormModal } from "@/modules/configuration/components/GeneralSettingFormModal";
import {
  createBranch,
  createContractType,
  deleteBranch,
  deleteContractType,
  deleteGeneralSetting,
  getBranches,
  getContractTypes,
  getGeneralSettings,
  updateBranch,
  updateBranchStatus,
  updateContractType,
  updateContractTypeStatus,
  upsertGeneralSetting
} from "@/modules/configuration/services/configurationApi";
import type {
  ConfigurationCatalogItem,
  ConfigurationCatalogPayload,
  GeneralSettingItem
} from "@/modules/configuration/types/configuration.types";
 TipoModulo = "branches" | "contract-types" | "general-settings";
 EstadoModalCatalogo =
  | { mode: "create"; item: null }
  | { mode: "edit"; item: ConfigurationCatalogItem }
  | null;
 EstadoModalParametro =
  | { mode: "create"; item: null }
  | { mode: "edit"; item: GeneralSettingItem }
  | null;
 EstadoEliminar =
  | { module: "catalog"; id: string; label: string }
  | { module: "setting"; id: string; label: string }
  | null;
 tamanioPagina = 10;
 function PaginaConfiguracion(): JSX.Element {
  const { user } = useAuth();
  const queryClient = useQueryClient();

  const [tipoModulo, setTipoModulo] = useState<TipoModulo>("branches");
  const [estadoModalCatalogo, setEstadoModalCatalogo] = useState<EstadoModalCatalogo>(null);
  const [estadoModalParametro, setEstadoModalParametro] = useState<EstadoModalParametro>(null);
  const [numeroPagina, setNumeroPagina] = useState(1);
  const [borrador, setBorrador] = useState("");
  const [busqueda, setBusqueda] = useState("");
  const [filtroEstado, setFiltroEstado] = useState<"all" | "active" | "inactive">("all");
  const [retroalimentacion, setRetroalimentacion] = useState<{ type: "success" | "error"; message: string } | null>(null);
  const [estadoEliminar, setEstadoEliminar] = useState<EstadoEliminar>(null);

  const puedeCrear = user.permissions.includes("configuration.create") ? false;
  const puedeEditar = user.permissions.includes("configuration.edit") ? false;
  const puedeEliminar = user.permissions.includes("configuration.delete") ? false;

  const catalogoQuery = useQuery({
    queryKey: ["configuration", tipoModulo, numeroPagina, busqueda, filtroEstado],
    queryFn: () => {
      if (tipoModulo === "general-settings") {
        return Promise.resolve(null);
      }

      const query = {
        pageNumber: numeroPagina,
        pageSize: tamanioPagina,
        search: busqueda || undefined,
        isActive: filtroEstado === "all" ? undefined : filtroEstado === "active",
        sortBy: "name",
        sortDirection: "asc" as const
      };

      return tipoModulo === "branches" ? getBranches(query) : getContractTypes(query);
    },
    enabled: tipoModulo !== "general-settings"
  });

  const parametrosQuery = useQuery({
    queryKey: ["general-settings", busqueda],
    queryFn: () => getGeneralSettings(busqueda || undefined),
    enabled: tipoModulo === "general-settings"
  });

  const mutacionCrearCatalogo = useMutation({
    mutationFn: (payload: ConfigurationCatalogPayload) =>
      tipoModulo === "branches" ? createBranch(payload) : createContractType(payload),
    onSuccess: async () => {
      await queryClient.invalidateQueries({ queryKey: ["configuration"] });
      setRetroalimentacion({ type: "success", message: "Registro creado correctamente." });
      setEstadoModalCatalogo(null);
    },
    onError: () => setRetroalimentacion({ type: "error", message: "No se pudo crear el registro." })
  });

  const mutacionActualizarCatalogo = useMutation({
    mutationFn: ({ id, payload }: { id: string; payload: ConfigurationCatalogPayload }) =>
      tipoModulo === "branches" ? updateBranch(id, payload) : updateContractType(id, payload),
    onSuccess: async () => {
      await queryClient.invalidateQueries({ queryKey: ["configuration"] });
      setRetroalimentacion({ type: "success", message: "Registro actualizado correctamente." });
      setEstadoModalCatalogo(null);
    },
    onError: () => setRetroalimentacion({ type: "error", message: "No se pudo actualizar el registro." })
  });

  const mutacionActualizarEstado = useMutation({
    mutationFn: ({ id, isActive }: { id: string; isActive: boolean }) =>
      tipoModulo === "branches" ? updateBranchStatus(id, isActive) : updateContractTypeStatus(id, isActive),
    onSuccess: async () => {
      await queryClient.invalidateQueries({ queryKey: ["configuration"] });
      setRetroalimentacion({ type: "success", message: "Estado actualizado." });
    },
    onError: () => setRetroalimentacion({ type: "error", message: "No se pudo actualizar el estado." })
  });

  const mutacionEliminarCatalogo = useMutation({
    mutationFn: (id: string) => (tipoModulo === "branches" ? deleteBranch(id) : deleteContractType(id)),
    onSuccess: async () => {
      await queryClient.invalidateQueries({ queryKey: ["configuration"] });
      setRetroalimentacion({ type: "success", message: "Registro eliminado." });
    },
    onError: () => setRetroalimentacion({ type: "error", message: "No se pudo eliminar. Verifica dependencias." })
  });

  const mutacionGuardarParametro = useMutation({
    mutationFn: ({ key, payload }: { key: string; payload: { value: string; description: string; isSensitive: boolean } }) =>
      upsertGeneralSetting(key, payload),
    onSuccess: async () => {
      await queryClient.invalidateQueries({ queryKey: ["general-settings"] });
      setRetroalimentacion({ type: "success", message: "Parametro guardado." });
      setEstadoModalParametro(null);
    },
    onError: () => setRetroalimentacion({ type: "error", message: "No se pudo guardar el parametro." })
  });

  const mutacionEliminarParametro = useMutation({
    mutationFn: deleteGeneralSetting,
    onSuccess: async () => {
      await queryClient.invalidateQueries({ queryKey: ["general-settings"] });
      setRetroalimentacion({ type: "success", message: "Parametro eliminado." });
    },
    onError: () => setRetroalimentacion({ type: "error", message: "No se pudo eliminar el parametro." })
  });

  const totalPaginas = useMemo(() => {
    const total = catalogoQuery.data.totalCount  0;
    return Math.max(1, Math.ceil(total / tamanioPagina));
  }, [catalogoQuery.data.totalCount]);

  function cambiarModulo(siguiente: TipoModulo): void {
    setTipoModulo(siguiente);
    setBusqueda("");
    setBorrador("");
    setFiltroEstado("all");
    setNumeroPagina(1);
    setEstadoModalCatalogo(null);
    setEstadoModalParametro(null);
  }

  return (
    <section className="animate-fade-up space-y-5">
      <PageHeader
        title="ConfiguraciÃ³n"
        description="GestiÃ³n de sedes, tipos de contrato y parÃ¡metros generales."
        action={
          tipoModulo === "general-settings"
             puedeCrear
               (
                  <Button
                    size="lg"
                    className="btn-create"
                    onClick={() => setEstadoModalParametro({ mode: "create", item: null })}
                  >
                    <Plus className="size-4" /> Nuevo parÃ¡metro
                  </Button>
                )
              : undefined
            : puedeCrear
               (
                  <Button
                    size="lg"
                    className="btn-create"
                    onClick={() => setEstadoModalCatalogo({ mode: "create", item: null })}
                  >
                    <Plus className="size-4" /> Nuevo registro
                  </Button>
                )
              : undefined
        }
      />

      <div className="flex flex-wrap gap-2">
        <Button variant={tipoModulo === "branches" ? "primary" : "secondary"} onClick={() => cambiarModulo("branches")}>
          Sedes
        </Button>
        <Button variant={tipoModulo === "contract-types" ? "primary" : "secondary"} onClick={() => cambiarModulo("contract-types")}>
          Tipos de contrato
        </Button>
        <Button variant={tipoModulo === "general-settings" ? "primary" : "secondary"} onClick={() => cambiarModulo("general-settings")}>
          <Cog className="mr-2 size-4" /> Parametros generales
        </Button>
      </div>

      {retroalimentacion ? (
        <Alert
          variant={retroalimentacion.type === "success" ? "success" : "error"}
          message={retroalimentacion.message}
          onClose={() => setRetroalimentacion(null)}
        />
      ) : null}

      {tipoModulo === "general-settings" ? (
        <Card>
          <CardHeader className="flex flex-col gap-3">
            <div className="flex items-center justify-between gap-3">
              <CardTitle>Parametros generales</CardTitle>
              {parametrosQuery.data.length ? (
                <span className="rounded-full bg-slate-100 px-2.5 py-0.5 text-[11px] font-semibold text-slate-600">
                  {parametrosQuery.data.length} registros
                </span>
              ) : null}
            </div>
            <div className="grid gap-2.5 grid-cols-1 sm:grid-cols-[2fr_auto]">
              <div>
                <label className="mb-1 block text-[10px] font-semibold uppercase tracking-wide text-slate-500">Buscar</label>
                <Input value={borrador} onChange={(event) => setBorrador(event.target.value)} placeholder="Buscar..." />
              </div>
              <div className="flex items-end">
                <Button
                  variant="secondary"
                  onClick={() => {
                    setBusqueda(borrador.trim());
                    setNumeroPagina(1);
                  }}
                >
                  Aplicar
                </Button>
              </div>
            </div>
          </CardHeader>
          <CardContent>
            <div className="overflow-x-auto rounded-2xl border bg-white">
              <table className="w-full border-collapse text-sm">
                <thead className="surface-muted">
                  <tr>
                    <th className="px-3 py-3 text-left font-semibold">Clave</th>
                    <th className="px-3 py-3 text-left font-semibold">Valor</th>
                    <th className="px-3 py-3 text-left font-semibold">Descripcion</th>
                    <th className="px-3 py-3 text-left font-semibold">Tipo</th>
                    <th className="px-3 py-3 text-right font-semibold">Acciones</th>
                  </tr>
                </thead>
                <tbody>
                  {parametrosQuery.isLoading ? (
                    <TableSkeleton cols={5} />
                  ) : parametrosQuery.data.length ? (
                    parametrosQuery.data.map((item) => (
                      <tr key={item.id} className="border-t transition-colors hover:bg-slate-50/70">
                        <td className="px-3 py-3 font-semibold">{item.key}</td>
                        <td className="px-3 py-3">{item.isSensitive ? "********" : item.value}</td>
                        <td className="px-3 py-3">{item.description ? "-"}</td>
                        <td className="px-3 py-3">
                          <Badge variant={item.isSensitive ? "danger" : "neutral"}>
                            {item.isSensitive ? "Sensible" : "Publico"}
                          </Badge>
                        </td>
                        <td className="px-3 py-3">
                          <div className="flex justify-end gap-1">
                            {puedeEditar ? (
                              <Button size="sm" variant="ghost" onClick={() => setEstadoModalParametro({ mode: "edit", item })}>
                                <Edit className="size-4" />
                              </Button>
                            ) : null}

                            {puedeEliminar ? (
                              <Button
                                size="sm"
                                variant="ghost"
                                onClick={() => {
                                  setEstadoEliminar({ module: "setting", id: item.id, label: item.key });
                                }}
                              >
                                <Trash2 className="size-4" />
                              </Button>
                            ) : null}
                          </div>
                        </td>
                      </tr>
                    ))
                  ) : (
                    <TableEmptyState cols={5} icon={Cog} message="Sin parÃ¡metros registrados." />
                  )}
                </tbody>
              </table>
            </div>
          </CardContent>
        </Card>
      ) : (
        <Card>
          <CardHeader className="flex flex-col gap-3">
            <div className="flex items-center justify-between gap-3">
              <CardTitle>{tipoModulo === "branches" ? "Sedes" : "Tipos de contrato"}</CardTitle>
              {catalogoQuery.data.totalCount ? (
                <span className="rounded-full bg-slate-100 px-2.5 py-0.5 text-[11px] font-semibold text-slate-600">
                  {catalogoQuery.data.totalCount} registros
                </span>
              ) : null}
            </div>
            <div className="grid gap-2.5 grid-cols-1 sm:grid-cols-2 lg:grid-cols-[2fr_1fr_auto]">
              <div>
                <label className="mb-1 block text-[10px] font-semibold uppercase tracking-wide text-slate-500">Buscar</label>
                <Input value={borrador} onChange={(event) => setBorrador(event.target.value)} placeholder="Buscar..." />
              </div>
              <div>
                <label className="mb-1 block text-[10px] font-semibold uppercase tracking-wide text-slate-500">Estado</label>
                <Select value={filtroEstado} onChange={(event) => { setFiltroEstado(event.target.value as "all" | "active" | "inactive"); setNumeroPagina(1); }}>
                  <option value="all">Todos los estados</option>
                  <option value="active">Activos</option>
                  <option value="inactive">Inactivos</option>
                </Select>
              </div>
              <div className="flex items-end">
                <Button
                  variant="secondary"
                  onClick={() => {
                    setBusqueda(borrador.trim());
                    setNumeroPagina(1);
                  }}
                >
                  Aplicar
                </Button>
              </div>
            </div>
          </CardHeader>
          <CardContent>
            <div className="overflow-x-auto rounded-2xl border bg-white">
              <table className="w-full border-collapse text-sm">
                <thead className="surface-muted">
                  <tr>
                    <th className="px-3 py-3 text-left font-semibold">Codigo</th>
                    <th className="px-3 py-3 text-left font-semibold">Nombre</th>
                    <th className="px-3 py-3 text-left font-semibold">Empleados</th>
                    <th className="px-3 py-3 text-left font-semibold">Estado</th>
                    <th className="px-3 py-3 text-right font-semibold">Acciones</th>
                  </tr>
                </thead>
                <tbody>
                  {catalogoQuery.isLoading ? (
                    <TableSkeleton cols={5} />
                  ) : catalogoQuery.data.items.length ? (
                    catalogoQuery.data.items.map((item) => (
                      <tr key={item.id} className="border-t transition-colors hover:bg-slate-50/70">
                        <td className="px-3 py-3 font-semibold">{item.code}</td>
                        <td className="px-3 py-3">{item.name}</td>
                        <td className="px-3 py-3">{item.employeesCount}</td>
                        <td className="px-3 py-3">
                          <Badge variant={item.isActive ? "success" : "danger"}>
                            {item.isActive ? "Activo" : "Inactivo"}
                          </Badge>
                        </td>
                        <td className="px-3 py-3">
                          <div className="flex justify-end gap-1">
                            {puedeEditar ? (
                              <Button size="sm" variant="ghost" onClick={() => setEstadoModalCatalogo({ mode: "edit", item })}>
                                <Pencil className="size-4" />
                              </Button>
                            ) : null}

                            {puedeEditar ? (
                              <Button size="sm" variant="ghost" onClick={() => mutacionActualizarEstado.mutate({ id: item.id, isActive: !item.isActive })}>
                                {item.isActive ? <UserX className="size-4" /> : <UserCheck className="size-4" />}
                              </Button>
                            ) : null}

                            {puedeEliminar ? (
                              <Button
                                size="sm"
                                variant="ghost"
                                onClick={() => {
                                  setEstadoEliminar({ module: "catalog", id: item.id, label: item.name });
                                }}
                              >
                                <Trash2 className="size-4" />
                              </Button>
                            ) : null}
                          </div>
                        </td>
                      </tr>
                    ))
                  ) : (
                    <TableEmptyState cols={5} message="Sin resultados." />
                  )}
                </tbody>
              </table>
            </div>

            <div className="mt-1">
              <Pagination
                page={numeroPagina}
                totalPages={totalPaginas}
                totalCount={catalogoQuery.data.totalCount  0}
                pageSize={tamanioPagina}
                onChange={setNumeroPagina}
              />
            </div>
          </CardContent>
        </Card>
      )}

      <ConfigurationCatalogFormModal
        open={estadoModalCatalogo !== null}
        title={estadoModalCatalogo.mode === "create"
           `Nuevo ${tipoModulo === "branches" ? "sede" : "tipo de contrato"}`
          : `Editar ${tipoModulo === "branches" ? "sede" : "tipo de contrato"}`}
        mode={estadoModalCatalogo.mode ? "create"}
        item={estadoModalCatalogo.item ? null}
        saving={mutacionCrearCatalogo.isPending || mutacionActualizarCatalogo.isPending}
        onClose={() => setEstadoModalCatalogo(null)}
        onSubmit={async (payload) => {
          if (estadoModalCatalogo.mode === "edit" && estadoModalCatalogo.item) {
            await mutacionActualizarCatalogo.mutateAsync({ id: estadoModalCatalogo.item.id, payload });
            return;
          }

          await mutacionCrearCatalogo.mutateAsync(payload);
        }}
      />

      <GeneralSettingFormModal
        open={estadoModalParametro !== null}
        mode={estadoModalParametro.mode ? "create"}
        item={estadoModalParametro.item ? null}
        saving={mutacionGuardarParametro.isPending}
        onClose={() => setEstadoModalParametro(null)}
        onSubmit={async (key, payload) => {
          await mutacionGuardarParametro.mutateAsync({ key, payload });
        }}
      />

      <ConfirmModal
        open={estadoEliminar !== null}
        title={estadoEliminar.module === "setting" ? "Eliminar parÃ¡metro" : "Eliminar registro"}
        message={
          estadoEliminar.module === "setting"
             `Se eliminarÃ¡ el parÃ¡metro ${estadoEliminar.label}. Â¿Deseas continuar`
            : `Se eliminarÃ¡ ${estadoEliminar.label ? "este registro"}. Â¿Deseas continuar`
        }
        confirmLabel="Eliminar"
        variant="danger"
        loading={mutacionEliminarCatalogo.isPending || mutacionEliminarParametro.isPending}
        onConfirm={() => {
          if (!estadoEliminar) return;
          if (estadoEliminar.module === "setting") {
            mutacionEliminarParametro.mutate(estadoEliminar.id, {
              onSuccess: () => setEstadoEliminar(null),
              onError: () => setEstadoEliminar(null)
            });
            return;
          }
          mutacionEliminarCatalogo.mutate(estadoEliminar.id, {
            onSuccess: () => setEstadoEliminar(null),
            onError: () => setEstadoEliminar(null)
          });
        }}
        onClose={() => setEstadoEliminar(null)}
      />
    </section>
  );
}


