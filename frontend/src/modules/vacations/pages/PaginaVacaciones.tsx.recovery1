import { useMemo, useState } from "react";
import { useMutation, useQuery, useQueryClient } from "@tanstack/react-query";
import { Ban, CalendarDays, Check, Clock3, X } from "lucide-react";
import { useAuth } from "@/modules/auth/hooks/useAuth";
import { Badge } from "@/components/ui/badge";
import { Button } from "@/components/ui/button";
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
import { Input } from "@/components/ui/input";
import { Select } from "@/components/ui/select";
import { Alert } from "@/components/ui/alert";
import { TableSkeleton } from "@/components/ui/skeleton";
import { TableEmptyState } from "@/components/ui/empty-state";
import { Pagination } from "@/components/ui/pagination";
import { PageHeader } from "@/components/ui/page-header";
import { ApproveRejectModal } from "@/components/modals/ApproveRejectModal";
import { FormField } from "@/components/forms/FormField";
import {
  approveVacationRequest,
  cancelVacationRequest,
  createVacationRequest,
  getVacationCatalogs,
  getVacations,
  rejectVacationRequest
} from "@/modules/vacations/services/vacationsApi";
import type { VacationStatus } from "@/modules/vacations/types/vacation.types";
 ModalAprobacion = { id: string; action: "approve" | "reject" } | null;
 tamanioPagina = 10;
 function PaginaVacaciones(): JSX.Element {
  const { user } = useAuth();
  const queryClient = useQueryClient();
  const anioActual = new Date().getFullYear();

  const [borrador, setBorrador] = useState("");
  const [busqueda, setBusqueda] = useState("");
  const [numeroPagina, setNumeroPagina] = useState(1);
  const [anio, setAnio] = useState<number>(anioActual);
  const [filtroEstado, setFiltroEstado] = useState<"all" | VacationStatus>("all");
  const [filtroEmpleadoId, setFiltroEmpleadoId] = useState("");
  const [empleadoId, setEmpleadoId] = useState("");
  const [fechaInicio, setFechaInicio] = useState("");
  const [fechaFin, setFechaFin] = useState("");
  const [motivo, setMotivo] = useState("");
  const [modalAprobacion, setModalAprobacion] = useState<ModalAprobacion>(null);
  const [retroalimentacion, setRetroalimentacion] = useState<{ type: "success" | "error"; message: string } | null>(null);

  const puedeCrear = user.permissions.includes("vacations.create") ? false;
  const puedeAprobar = user.permissions.includes("vacations.approve") ? false;

  const catalogosQuery = useQuery({
    queryKey: ["vacations-catalogs", anio],
    queryFn: () => getVacationCatalogs(anio)
  });

  const vacacionesQuery = useQuery({
    queryKey: ["vacations", numeroPagina, busqueda, anio, filtroEstado, filtroEmpleadoId],
    queryFn: () =>
      getVacations({
        search: busqueda || undefined,
        employeeId: filtroEmpleadoId || undefined,
        year: anio,
        status: filtroEstado === "all" ? undefined : filtroEstado,
        pageNumber: numeroPagina,
        pageSize: tamanioPagina
      })
  });

  const saldoEmpleadoSeleccionado = useMemo(
    () => catalogosQuery.data.employees.find((item) => item.id === empleadoId),
    [catalogosQuery.data.employees, empleadoId]
  );

  const mutacionCrear = useMutation({
    mutationFn: createVacationRequest,
    onSuccess: async () => {
      await queryClient.invalidateQueries({ queryKey: ["vacations"] });
      await queryClient.invalidateQueries({ queryKey: ["vacations-catalogs"] });
      setRetroalimentacion({ type: "success", message: "Solicitud de vacaciones registrada." });
      setEmpleadoId("");
      setFechaInicio("");
      setFechaFin("");
      setMotivo("");
    },
    onError: () => {
      setRetroalimentacion({ type: "error", message: "No se pudo registrar la solicitud." });
    }
  });

  const mutacionAprobar = useMutation({
    mutationFn: ({ id, comment }: { id: string; comment: string }) => approveVacationRequest(id, comment),
    onSuccess: async () => {
      await queryClient.invalidateQueries({ queryKey: ["vacations"] });
      await queryClient.invalidateQueries({ queryKey: ["vacations-catalogs"] });
      setRetroalimentacion({ type: "success", message: "Solicitud aprobada." });
      setModalAprobacion(null);
    },
    onError: () => {
      setRetroalimentacion({ type: "error", message: "No se pudo aprobar la solicitud." });
    }
  });

  const mutacionRechazar = useMutation({
    mutationFn: ({ id, comment }: { id: string; comment: string }) => rejectVacationRequest(id, comment),
    onSuccess: async () => {
      await queryClient.invalidateQueries({ queryKey: ["vacations"] });
      await queryClient.invalidateQueries({ queryKey: ["vacations-catalogs"] });
      setRetroalimentacion({ type: "success", message: "Solicitud rechazada." });
      setModalAprobacion(null);
    },
    onError: () => {
      setRetroalimentacion({ type: "error", message: "No se pudo rechazar la solicitud." });
    }
  });

  const mutacionCancelar = useMutation({
    mutationFn: cancelVacationRequest,
    onSuccess: async () => {
      await queryClient.invalidateQueries({ queryKey: ["vacations"] });
      await queryClient.invalidateQueries({ queryKey: ["vacations-catalogs"] });
      setRetroalimentacion({ type: "success", message: "Solicitud cancelada." });
    },
    onError: () => {
      setRetroalimentacion({ type: "error", message: "No se pudo cancelar la solicitud." });
    }
  });

  const totalPaginas = useMemo(() => {
    const total = vacacionesQuery.data.totalCount  0;
    return Math.max(1, Math.ceil(total / tamanioPagina));
  }, [vacacionesQuery.data.totalCount]);

  const procesando = mutacionAprobar.isPending || mutacionRechazar.isPending;

  return (
    <section className="animate-fade-up space-y-5">
      <PageHeader
        title="Vacaciones"
        description="Solicitudes, aprobaciones/rechazos y control de saldo anual."
      />

      {retroalimentacion ? (
        <Alert
          variant={retroalimentacion.type === "success" ? "success" : "error"}
          message={retroalimentacion.message}
          onClose={() => setRetroalimentacion(null)}
        />
      ) : null}

      {/* Nueva solicitud */}
      <Card>
        <CardHeader>
          <CardTitle>Nueva solicitud</CardTitle>
        </CardHeader>
        <CardContent className="grid gap-3 grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-[2fr_1fr_1fr_2fr_auto]">
          <FormField label="Empleado" required>
            <Select value={empleadoId} onChange={(e) => setEmpleadoId(e.target.value)}>
              <option value="">Selecciona empleado</option>
              {catalogosQuery.data.employees.map((item) => (
                <option key={item.id} value={item.id}>{item.label}</option>
              ))}
            </Select>
          </FormField>
          <FormField label="Desde" required>
            <Input type="date" value={fechaInicio} onChange={(e) => setFechaInicio(e.target.value)} />
          </FormField>
          <FormField label="Hasta" required>
            <Input type="date" value={fechaFin} onChange={(e) => setFechaFin(e.target.value)} />
          </FormField>
          <FormField label="Motivo">
            <Input value={motivo} onChange={(e) => setMotivo(e.target.value)} placeholder="Motivo (opcional)" />
          </FormField>
          <div className="flex items-end">
            <Button
              disabled={!puedeCrear || !empleadoId || !fechaInicio || !fechaFin || mutacionCrear.isPending}
              onClick={() => mutacionCrear.mutate({ employeeId: empleadoId, startDate: fechaInicio, endDate: fechaFin, reason: motivo.trim() || undefined })}
            >
              {mutacionCrear.isPending ? "Enviando..." : "Solicitar"}
            </Button>
          </div>
        </CardContent>

        {/* Saldo del empleado */}
        {saldoEmpleadoSeleccionado ? (
          <CardContent className="pt-0">
            <div className="flex flex-wrap gap-3">
              <div className="flex items-center gap-2 rounded-lg bg-emerald-50 px-3 py-1.5">
                <CalendarDays className="size-3.5 text-emerald-600" />
                <span className="text-[12px] text-emerald-700">
                  Disponible: <span className="font-bold">{saldoEmpleadoSeleccionado.availableDays}</span> dÃ­as
                </span>
              </div>
              <div className="flex items-center gap-2 rounded-lg bg-brand-50 px-3 py-1.5">
                <Check className="size-3.5 text-brand-600" />
                <span className="text-[12px] text-brand-700">
                  Aprobados: <span className="font-bold">{saldoEmpleadoSeleccionado.usedDays}</span> dÃ­as
                </span>
              </div>
              <div className="flex items-center gap-2 rounded-lg bg-amber-50 px-3 py-1.5">
                <Clock3 className="size-3.5 text-amber-600" />
                <span className="text-[12px] text-amber-700">
                  Pendientes: <span className="font-bold">{saldoEmpleadoSeleccionado.pendingDays}</span> dÃ­as
                </span>
              </div>
            </div>
          </CardContent>
        ) : null}
      </Card>

      {/* Tabla con filtros */}
      <Card>
        <CardHeader className="flex flex-col gap-3">
          <div className="flex items-center justify-between gap-3">
            <CardTitle>Historial de solicitudes</CardTitle>
            {vacacionesQuery.data.totalCount ? (
              <span className="rounded-full bg-slate-100 px-2.5 py-0.5 text-[11px] font-semibold text-slate-600">
                {vacacionesQuery.data.totalCount} registros
              </span>
            ) : null}
          </div>

          {/* Filtros */}
          <div className="grid gap-2.5 grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-[2fr_1fr_1fr_120px_auto]">
            <div>
              <label className="mb-1 block text-[10px] font-semibold uppercase tracking-wide text-slate-500">Buscar</label>
              <Input
                value={borrador}
                onChange={(e) => setBorrador(e.target.value)}
                onKeyDown={(e) => { if (e.key === "Enter") { setBusqueda(borrador.trim()); setNumeroPagina(1); } }}
                placeholder="Empleado, cÃ³digo o Ã¡rea..."
              />
            </div>
            <div>
              <label className="mb-1 block text-[10px] font-semibold uppercase tracking-wide text-slate-500">Estado</label>
              <Select value={filtroEstado} onChange={(e) => { setFiltroEstado(e.target.value as "all" | VacationStatus); setNumeroPagina(1); }}>
                <option value="all">Todos los estados</option>
                <option value="pending">Pendiente</option>
                <option value="approved">Aprobada</option>
                <option value="rejected">Rechazada</option>
                <option value="cancelled">Cancelada</option>
              </Select>
            </div>
            <div>
              <label className="mb-1 block text-[10px] font-semibold uppercase tracking-wide text-slate-500">Empleado</label>
              <Select value={filtroEmpleadoId} onChange={(e) => { setFiltroEmpleadoId(e.target.value); setNumeroPagina(1); }}>
                <option value="">Todos los empleados</option>
                {catalogosQuery.data.employees.map((item) => (
                  <option key={item.id} value={item.id}>{item.label}</option>
                ))}
              </Select>
            </div>
            <div>
              <label className="mb-1 block text-[10px] font-semibold uppercase tracking-wide text-slate-500">AÃ±o</label>
              <Input
                type="number"
                min={anioActual - 10}
                max={anioActual + 5}
                value={anio}
                onChange={(e) => {
                  const valor = Number(e.target.value);
                  if (!Number.isFinite(valor)) return;
                  setAnio(valor);
                  setNumeroPagina(1);
                }}
              />
            </div>
            <div className="flex items-end">
              <Button variant="secondary" onClick={() => { setBusqueda(borrador.trim()); setNumeroPagina(1); }}>
                Buscar
              </Button>
            </div>
          </div>
        </CardHeader>
        <CardContent className="p-0 pb-4">
          <div className="overflow-x-auto">
            <table className="w-full border-collapse text-[13px]">
              <thead>
                <tr className="border-b bg-slate-50">
                  {["Empleado", "Rango", "DÃ­as", "Estado", "Comentarios", ""].map((col) => (
                    <th
                      key={col}
                      className="px-4 py-2.5 text-left text-[11px] font-bold uppercase tracking-wide text-slate-400 last:text-right"
                    >
                      {col}
                    </th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {vacacionesQuery.isLoading ? (
                  <TableSkeleton cols={6} />
                ) : vacacionesQuery.data.items.length ? (
                  vacacionesQuery.data.items.map((item) => {
                    const etiquetaEstado = item.status === "approved" ? "Aprobada" : item.status === "rejected" ? "Rechazada" : item.status === "cancelled" ? "Cancelada" : "Pendiente";
                    const varianteEstado = item.status === "approved" ? "success" : item.status === "rejected" ? "danger" : item.status === "cancelled" ? "warning" : "neutral";

                    return (
                      <tr key={item.id} className="border-t transition-colors hover:bg-slate-50/70">
                        <td className="px-4 py-3">
                          <p className="font-semibold text-slate-800">{item.employeeName}</p>
                          <p className="text-[11px] text-muted">{item.employeeCode} Â· {item.area}</p>
                        </td>
                        <td className="px-4 py-3 text-slate-600">
                          {item.startDate} <span className="text-slate-300">â†’</span> {item.endDate}
                        </td>
                        <td className="px-4 py-3 tabular-nums font-medium text-slate-700">{item.requestedDays}</td>
                        <td className="px-4 py-3">
                          <Badge variant={varianteEstado as "success" | "danger" | "neutral"}>{etiquetaEstado}</Badge>
                        </td>
                        <td className="max-w-[180px] px-4 py-3">
                          <p className="truncate text-slate-600">{item.reason ? <span className="text-slate-300">â€”</span>}</p>
                          {item.reviewerComment ? (
                            <p className="truncate text-[11px] text-muted italic">{item.reviewerComment}</p>
                          ) : null}
                        </td>
                        <td className="px-4 py-3">
                          <div className="flex justify-end gap-0.5">
                            {puedeAprobar && item.status === "pending" ? (
                              <>
                                <button
                                  className="flex size-8 items-center justify-center rounded-lg text-slate-400 transition hover:bg-emerald-50 hover:text-emerald-600"
                                  title="Aprobar"
                                  onClick={() => setModalAprobacion({ id: item.id, action: "approve" })}
                                >
                                  <Check className="size-3.5" />
                                </button>
                                <button
                                  className="flex size-8 items-center justify-center rounded-lg text-slate-400 transition hover:bg-rose-50 hover:text-rose-500"
                                  title="Rechazar"
                                  onClick={() => setModalAprobacion({ id: item.id, action: "reject" })}
                                >
                                  <X className="size-3.5" />
                                </button>
                                <button
                                  className="flex size-8 items-center justify-center rounded-lg text-slate-400 transition hover:bg-amber-50 hover:text-amber-600"
                                  title="Cancelar solicitud"
                                  disabled={mutacionCancelar.isPending}
                                  onClick={() => mutacionCancelar.mutate(item.id)}
                                >
                                  <Ban className="size-3.5" />
                                </button>
                              </>
                            ) : puedeCrear && item.status === "pending" ? (
                              <button
                                className="flex size-8 items-center justify-center rounded-lg text-slate-400 transition hover:bg-amber-50 hover:text-amber-600"
                                title="Cancelar solicitud"
                                disabled={mutacionCancelar.isPending}
                                onClick={() => mutacionCancelar.mutate(item.id)}
                              >
                                <Ban className="size-3.5" />
                              </button>
                            ) : null}
                          </div>
                        </td>
                      </tr>
                    );
                  })
                ) : (
                  <TableEmptyState
                    cols={6}
                    icon={CalendarDays}
                    message="Sin solicitudes para el filtro actual."
                  />
                )}
              </tbody>
            </table>
          </div>

          <div className="px-4">
            <Pagination
              page={numeroPagina}
              totalPages={totalPaginas}
              totalCount={vacacionesQuery.data.totalCount  0}
              pageSize={tamanioPagina}
              onChange={setNumeroPagina}
            />
          </div>
        </CardContent>
      </Card>

      <ApproveRejectModal
        open={modalAprobacion !== null}
        action={modalAprobacion.action ? "approve"}
        title={modalAprobacion.action === "approve" ? "Aprobar solicitud de vacaciones" : "Rechazar solicitud de vacaciones"}
        requireComment={modalAprobacion.action === "reject"}
        loading={procesando}
        onConfirm={(comment) => {
          if (!modalAprobacion) return;
          if (modalAprobacion.action === "approve") {
            mutacionAprobar.mutate({ id: modalAprobacion.id, comment });
          } else {
            if (!comment) return;
            mutacionRechazar.mutate({ id: modalAprobacion.id, comment });
          }
        }}
        onClose={() => setModalAprobacion(null)}
      />
    </section>
  );
}


