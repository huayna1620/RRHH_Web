import { useState } from "react";
import { useMutation, useQuery, useQueryClient } from "@tanstack/react-query";
import {
  CheckCircle2,
  ChevronDown,
  ChevronRight,
  ClipboardCheck,
  ListChecks,
  Plus,
  Trash2
} from "lucide-react";
import { useAuth } from "@/modules/auth/hooks/useAuth";
import { Badge } from "@/components/ui/badge";
import { Button } from "@/components/ui/button";
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
import { Input } from "@/components/ui/input";
import { Select } from "@/components/ui/select";
import { Alert } from "@/components/ui/alert";
import { TableSkeleton } from "@/components/ui/skeleton";
import { TableEmptyState } from "@/components/ui/empty-state";
import { PageHeader } from "@/components/ui/page-header";
import { Modal } from "@/components/ui/modal";
import { FormField } from "@/components/forms/FormField";
import { ConfirmModal } from "@/components/modals/ConfirmModal";
import {
  getTemplates,
  createTemplate,
  deleteTemplate,
  getProcesses,
  startProcess,
  completeTask
} from "@/modules/onboarding/services/onboardingApi";
import { getEmployees } from "@/modules/employees/services/employeesApi";
import type { OnboardingTemplate, OnboardingProcess, CreateTemplateTaskPayload } from "@/modules/onboarding/types/onboarding.types";
 Pestania = "templates" | "processes";
 function PaginaOnboarding(): JSX.Element {
  const { user } = useAuth();
  const queryClient = useQueryClient();
  const permisos = user.permissions ?? [];
  const puedeCrear = permisos.includes("onboarding.create");
  const puedeEditar = permisos.includes("onboarding.edit");

  const [pestania, setPestania] = useState<Pestania>("processes");
  const [retroalimentacion, setRetroalimentacion] = useState<{ type: "success" | "error"; message: string } | null>(null);

  // Formulario de plantilla
  const [mostrarModalPlantilla, setMostrarModalPlantilla] = useState(false);
  const [nombrePlantilla, setNombrePlantilla] = useState("");
  const [descPlantilla, setDescPlantilla] = useState("");
  const [tareasPlantilla, setTareasPlantilla] = useState<CreateTemplateTaskPayload[]>([
    { title: "", description: "", sortOrder: 1 }
  ]);
  const [objetivoEliminar, setObjetivoEliminar] = useState<OnboardingTemplate | null>(null);

  // Formulario de proceso
  const [mostrarModalProceso, setMostrarModalProceso] = useState(false);
  const [empleadoSeleccionado, setEmpleadoSeleccionado] = useState("");
  const [plantillaSeleccionada, setPlantillaSeleccionada] = useState("");

  // Filas de proceso expandidas
  const [procesoExpandido, setProcesoExpandido] = useState<string | null>(null);

  // Consultas
  const plantillasQuery = useQuery({ queryKey: ["onboarding-templates"], queryFn: getTemplates });
  const procesosQuery = useQuery({ queryKey: ["onboarding-processes"], queryFn: () => getProcesses() });
  const empleadosQuery = useQuery({
    queryKey: ["employees-list-onboarding"],
    queryFn: () => getEmployees({ pageNumber: 1, pageSize: 500, isActive: true }),
    enabled: mostrarModalProceso
  });

  // Mutaciones
  const mutacionCrearPlantilla = useMutation({
    mutationFn: createTemplate,
    onSuccess: () => {
      queryClient.invalidateQueries({ queryKey: ["onboarding-templates"] });
      setMostrarModalPlantilla(false);
      setRetroalimentacion({ type: "success", message: "Plantilla creada correctamente." });
    },
    onError: () => setRetroalimentacion({ type: "error", message: "No se pudo crear la plantilla." })
  });

  const mutacionEliminarPlantilla = useMutation({
    mutationFn: deleteTemplate,
    onSuccess: () => {
      queryClient.invalidateQueries({ queryKey: ["onboarding-templates"] });
      setObjetivoEliminar(null);
      setRetroalimentacion({ type: "success", message: "Plantilla eliminada." });
    },
    onError: () => setRetroalimentacion({ type: "error", message: "No se pudo eliminar la plantilla." })
  });

  const mutacionIniciarProceso = useMutation({
    mutationFn: startProcess,
    onSuccess: () => {
      queryClient.invalidateQueries({ queryKey: ["onboarding-processes"] });
      setMostrarModalProceso(false);
      setRetroalimentacion({ type: "success", message: "Proceso de onboarding iniciado." });
    },
    onError: () => setRetroalimentacion({ type: "error", message: "No se pudo iniciar el proceso." })
  });

  const mutacionCompletarTarea = useMutation({
    mutationFn: ({ processId, taskId }: { processId: string; taskId: string }) => completeTask(processId, taskId),
    onSuccess: () => {
      queryClient.invalidateQueries({ queryKey: ["onboarding-processes"] });
      setRetroalimentacion({ type: "success", message: "Tarea completada." });
    },
    onError: () => setRetroalimentacion({ type: "error", message: "No se pudo completar la tarea." })
  });

  function abrirModalPlantilla(): void {
    setNombrePlantilla("");
    setDescPlantilla("");
    setTareasPlantilla([{ title: "", description: "", sortOrder: 1 }]);
    setMostrarModalPlantilla(true);
  }

  function agregarFilaTarea(): void {
    setTareasPlantilla((prev) => [...prev, { title: "", description: "", sortOrder: prev.length + 1 }]);
  }

  function quitarFilaTarea(indice: number): void {
    setTareasPlantilla((prev) => prev.filter((_, i) => i !== indice).map((t, i) => ({ ...t, sortOrder: i + 1 })));
  }

  function actualizarFilaTarea(indice: number, campo: "title" | "description", valor: string): void {
    setTareasPlantilla((prev) => prev.map((t, i) => (i === indice  { ...t, [campo]: valor } : t)));
  }

  function manejarCrearPlantilla(e: React.FormEvent): void {
    e.preventDefault();
    if (!nombrePlantilla.trim() || tareasPlantilla.some((t) => !t.title.trim())) return;
    mutacionCrearPlantilla.mutate({
      name: nombrePlantilla.trim(),
      description: descPlantilla.trim(),
      tasks: tareasPlantilla
    });
  }

  function abrirModalProceso(): void {
    setEmpleadoSeleccionado("");
    setPlantillaSeleccionada("");
    setMostrarModalProceso(true);
  }

  function manejarIniciarProceso(e: React.FormEvent): void {
    e.preventDefault();
    if (!empleadoSeleccionado || !plantillaSeleccionada) return;
    mutacionIniciarProceso.mutate({ employeeId: empleadoSeleccionado, templateId: plantillaSeleccionada });
  }

  const plantillas = plantillasQuery.data ?? [];
  const procesos = procesosQuery.data ?? [];
  const empleados = empleadosQuery.data.items ?? [];

  return (
    <div className="space-y-6">
      <PageHeader title="Onboarding" description="Gestiona plantillas y procesos de incorporacion de nuevos empleados." />

      {retroalimentacion && (
        <Alert variant={retroalimentacion.type === "success" ? "success" : "error"} message={retroalimentacion.message} onClose={() => setRetroalimentacion(null)} />
      )}

      {/* PestaÃ±as */}
      <div className="flex gap-1 rounded-lg bg-slate-100 p-1">
        <button
          onClick={() => setPestania("processes")}
          className={`flex items-center gap-1.5 rounded-md px-4 py-2 text-sm font-medium transition ${
            pestania === "processes" ? "bg-white text-slate-900 shadow-sm" : "text-slate-500 hover:text-slate-700"
          }`}
        >
          <ClipboardCheck className="size-4" /> Procesos
        </button>
        <button
          onClick={() => setPestania("templates")}
          className={`flex items-center gap-1.5 rounded-md px-4 py-2 text-sm font-medium transition ${
            pestania === "templates" ? "bg-white text-slate-900 shadow-sm" : "text-slate-500 hover:text-slate-700"
          }`}
        >
          <ListChecks className="size-4" /> Plantillas
        </button>
      </div>

      {/* â”€â”€ PestaÃ±a Procesos â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */}
      {pestania === "processes" && (
        <Card>
            <CardHeader>
              <div className="flex flex-wrap items-center justify-between gap-3">
              <CardTitle>Procesos de onboarding</CardTitle>
              {puedeCrear && (
                <Button size="sm" onClick={abrirModalProceso}>
                  <Plus className="mr-1.5 size-3.5" /> Iniciar proceso
                </Button>
              )}
            </div>
          </CardHeader>
          <CardContent>
            {procesosQuery.isLoading ? (
              <TableSkeleton rows={5} cols={6} />
            ) : procesos.length === 0 ? (
              <TableEmptyState cols={6} message="No hay procesos de onboarding." />
            ) : (
              <div className="overflow-x-auto">
                <table className="w-full text-left text-sm">
                  <thead>
                    <tr className="border-b text-xs font-semibold uppercase tracking-wider text-slate-500">
                      <th className="px-3 py-2.5 w-8" />
                      <th className="px-3 py-2.5">Empleado</th>
                      <th className="px-3 py-2.5">Plantilla</th>
                      <th className="px-3 py-2.5">Progreso</th>
                      <th className="px-3 py-2.5">Inicio</th>
                      <th className="px-3 py-2.5">Estado</th>
                    </tr>
                  </thead>
                  <tbody>
                    {procesos.map((p) => (
                      <FilaProceso
                        key={p.id}
                        process={p}
                        expanded={procesoExpandido === p.id}
                        onToggle={() => setProcesoExpandido(procesoExpandido === p.id ? null : p.id)}
                        canEdit={puedeEditar}
                        onCompleteTask={(taskId) => mutacionCompletarTarea.mutate({ processId: p.id, taskId })}
                        isCompletingTask={mutacionCompletarTarea.isPending}
                      />
                    ))}
                  </tbody>
                </table>
              </div>
            )}
          </CardContent>
        </Card>
      )}

      {/* â”€â”€ PestaÃ±a Plantillas â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */}
      {pestania === "templates" && (
        <Card>
            <CardHeader>
              <div className="flex flex-wrap items-center justify-between gap-3">
              <CardTitle>Plantillas de onboarding</CardTitle>
              {puedeCrear && (
                <Button size="lg" className="btn-create" onClick={abrirModalPlantilla}>
                  <Plus className="size-4" /> Nueva plantilla
                </Button>
              )}
            </div>
          </CardHeader>
          <CardContent>
            {plantillasQuery.isLoading ? (
              <TableSkeleton rows={4} cols={4} />
            ) : plantillas.length === 0 ? (
              <TableEmptyState cols={4} message="No hay plantillas creadas." />
            ) : (
              <div className="overflow-x-auto">
                <table className="w-full text-left text-sm">
                  <thead>
                    <tr className="border-b text-xs font-semibold uppercase tracking-wider text-slate-500">
                      <th className="px-3 py-2.5">Nombre</th>
                      <th className="px-3 py-2.5">Descripcion</th>
                      <th className="px-3 py-2.5">Tareas</th>
                      <th className="px-3 py-2.5">Estado</th>
                      {puedeEditar && <th className="px-3 py-2.5 text-right">Acciones</th>}
                    </tr>
                  </thead>
                  <tbody>
                    {plantillas.map((t) => (
                      <tr key={t.id} className="border-b last:border-0 hover:bg-slate-50/50">
                        <td className="px-3 py-2.5 font-medium">{t.name}</td>
                        <td className="px-3 py-2.5 text-slate-500 max-w-xs truncate">{t.description ? "-"}</td>
                        <td className="px-3 py-2.5">
                          <Badge variant="neutral">{t.tasks.length} tareas</Badge>
                        </td>
                        <td className="px-3 py-2.5">
                          <Badge variant={t.isActive ? "success" : "neutral"}>
                            {t.isActive ? "Activa" : "Inactiva"}
                          </Badge>
                        </td>
                        {puedeEditar && (
                          <td className="px-3 py-2.5 text-right">
                            <button
                              className="rounded-md p-1.5 text-slate-400 transition hover:bg-rose-50 hover:text-rose-500"
                              title="Eliminar"
                              onClick={() => setObjetivoEliminar(t)}
                            >
                              <Trash2 className="size-3.5" />
                            </button>
                          </td>
                        )}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}
          </CardContent>
        </Card>
      )}

      {/* â”€â”€ Modal Crear Plantilla â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */}
      <Modal open={mostrarModalPlantilla} title="Nueva plantilla de onboarding" onClose={() => setMostrarModalPlantilla(false)}>
        <form className="space-y-4" onSubmit={manejarCrearPlantilla}>
          <FormField label="Nombre de la plantilla" required>
            <Input value={nombrePlantilla} onChange={(e) => setNombrePlantilla(e.target.value)} required />
          </FormField>
          <FormField label="Descripcion">
            <Input value={descPlantilla} onChange={(e) => setDescPlantilla(e.target.value)} />
          </FormField>

            <div>
              <div className="mb-2 flex flex-wrap items-center justify-between gap-2">
              <p className="text-sm font-medium text-slate-700">Tareas</p>
              <button type="button" onClick={agregarFilaTarea} className="text-xs text-brand-600 hover:text-brand-700 font-medium">
                + Agregar tarea
              </button>
            </div>
            <div className="space-y-2">
              {tareasPlantilla.map((tarea, i) => (
                <div key={i} className="flex items-start gap-2 rounded-lg border border-slate-200 p-2.5">
                  <span className="mt-2 text-xs font-bold text-slate-400 w-5 shrink-0">{i + 1}</span>
                  <div className="flex-1 space-y-1.5">
                    <Input
                      placeholder="Titulo de la tarea"
                      value={tarea.title}
                      onChange={(e) => actualizarFilaTarea(i, "title", e.target.value)}
                      required
                    />
                    <Input
                      placeholder="Descripcion (opcional)"
                      value={tarea.description}
                      onChange={(e) => actualizarFilaTarea(i, "description", e.target.value)}
                    />
                  </div>
                  {tareasPlantilla.length > 1 && (
                    <button
                      type="button"
                      onClick={() => quitarFilaTarea(i)}
                      className="mt-2 text-slate-400 hover:text-rose-500"
                    >
                      <Trash2 className="size-3.5" />
                    </button>
                  )}
                </div>
              ))}
            </div>
          </div>

          <div className="flex justify-end gap-2">
            <Button variant="ghost" type="button" onClick={() => setMostrarModalPlantilla(false)}>
              Cancelar
            </Button>
            <Button type="submit" disabled={mutacionCrearPlantilla.isPending}>
              {mutacionCrearPlantilla.isPending ? "Creando..." : "Crear plantilla"}
            </Button>
          </div>
        </form>
      </Modal>

      {/* â”€â”€ Modal Iniciar Proceso â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */}
      <Modal open={mostrarModalProceso} title="Iniciar proceso de onboarding" onClose={() => setMostrarModalProceso(false)}>
        <form className="space-y-4" onSubmit={manejarIniciarProceso}>
          <FormField label="Empleado" required>
            <Select value={empleadoSeleccionado} onChange={(e) => setEmpleadoSeleccionado(e.target.value)} required>
              <option value="">Seleccionar empleado...</option>
              {empleados.map((emp) => (
                <option key={emp.id} value={emp.id}>
                  {emp.employeeCode} - {emp.fullName}
                </option>
              ))}
            </Select>
          </FormField>
          <FormField label="Plantilla" required>
            <Select value={plantillaSeleccionada} onChange={(e) => setPlantillaSeleccionada(e.target.value)} required>
              <option value="">Seleccionar plantilla...</option>
              {plantillas.filter((t) => t.isActive).map((t) => (
                <option key={t.id} value={t.id}>
                  {t.name} ({t.tasks.length} tareas)
                </option>
              ))}
            </Select>
          </FormField>
          <div className="flex justify-end gap-2">
            <Button variant="ghost" type="button" onClick={() => setMostrarModalProceso(false)}>
              Cancelar
            </Button>
            <Button type="submit" disabled={mutacionIniciarProceso.isPending}>
              {mutacionIniciarProceso.isPending ? "Iniciando..." : "Iniciar onboarding"}
            </Button>
          </div>
        </form>
      </Modal>

      {/* Confirmar eliminaciÃ³n */}
      <ConfirmModal
        open={objetivoEliminar !== null}
        title="Eliminar plantilla"
        message={`Seguro que deseas eliminar la plantilla "${objetivoEliminar.name}"`}
        variant="danger"
        confirmLabel="Eliminar"
        loading={mutacionEliminarPlantilla.isPending}
        onConfirm={() => { if (objetivoEliminar) mutacionEliminarPlantilla.mutate(objetivoEliminar.id); }}
        onClose={() => setObjetivoEliminar(null)}
      />
    </div>
  );
}

// â”€â”€ Fila de Proceso con tareas expandibles â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
function FilaProceso({
  process,
  expanded,
  onToggle,
  canEdit,
  onCompleteTask,
  isCompletingTask
}: {
  process: OnboardingProcess;
  expanded: boolean;
  onToggle: () => void;
  canEdit: boolean;
  onCompleteTask: (taskId: string) => void;
  isCompletingTask: boolean;
}): JSX.Element {
  const completado = process.completedAtUtc !== null;
  const colorProgreso = completado
     "bg-emerald-500"
    : process.progressPercent >= 50
     "bg-blue-500"
    : "bg-amber-500";

  return (
    <>
      <tr className="border-b hover:bg-slate-50/50 cursor-pointer" onClick={onToggle}>
        <td className="px-3 py-2.5">
          {expanded ? <ChevronDown className="size-4 text-slate-400" /> : <ChevronRight className="size-4 text-slate-400" />}
        </td>
        <td className="px-3 py-2.5">
          <div>
            <p className="font-medium">{process.employeeName}</p>
            <p className="text-xs text-slate-400">{process.employeeCode}</p>
          </div>
        </td>
        <td className="px-3 py-2.5 text-slate-600">{process.templateName}</td>
        <td className="px-3 py-2.5">
          <div className="flex items-center gap-2">
            <div className="h-2 w-24 rounded-full bg-slate-200">
              <div className={`h-2 rounded-full ${colorProgreso} transition-all`} style={{ width: `${process.progressPercent}%` }} />
            </div>
            <span className="text-xs font-medium text-slate-500">
              {process.completedTasks}/{process.totalTasks}
            </span>
          </div>
        </td>
        <td className="px-3 py-2.5 whitespace-nowrap text-xs font-mono text-slate-500">
          {new Date(process.startedAtUtc).toLocaleDateString()}
        </td>
        <td className="px-3 py-2.5">
          <Badge variant={completado ? "success" : "warning"}>
            {completado ? "Completado" : "En progreso"}
          </Badge>
        </td>
      </tr>
      {expanded && (
        <tr>
          <td colSpan={6} className="bg-slate-50/80 px-6 py-3">
            <div className="space-y-1.5">
              {process.tasks.map((tarea) => (
                <div
                  key={tarea.id}
                  className={`flex items-center gap-3 rounded-lg px-3 py-2 ${
                    tarea.isCompleted ? "bg-emerald-50" : "bg-white border border-slate-200"
                  }`}
                >
                  {tarea.isCompleted ? (
                    <CheckCircle2 className="size-4 text-emerald-500 shrink-0" />
                  ) : (
                    <div className="size-4 rounded-full border-2 border-slate-300 shrink-0" />
                  )}
                  <div className="flex-1 min-w-0">
                    <p className={`text-sm font-medium ${tarea.isCompleted ? "text-emerald-700 line-through" : "text-slate-700"}`}>
                      {tarea.title}
                    </p>
                    {tarea.description && <p className="text-xs text-slate-400 truncate">{tarea.description}</p>}
                    {tarea.isCompleted && tarea.completedByUserName && (
                      <p className="text-[11px] text-emerald-500 mt-0.5">
                        Completado por {tarea.completedByUserName} - {new Date(tarea.completedAtUtc!).toLocaleDateString()}
                      </p>
                    )}
                  </div>
                  {canEdit && !tarea.isCompleted && (
                    <Button
                      size="sm"
                      variant="outline"
                      onClick={(e) => {
                        e.stopPropagation();
                        onCompleteTask(tarea.id);
                      }}
                      disabled={isCompletingTask}
                    >
                      Completar
                    </Button>
                  )}
                </div>
              ))}
            </div>
          </td>
        </tr>
      )}
    </>
  );
}


