import { useQuery } from "@tanstack/react-query";
import {
  Briefcase,
  CalendarCheck,
  CalendarClock,
  Clock3,
  FileCheck2,
  PlaneTakeoff,
  TrendingUp,
  WalletCards,
} from "lucide-react";
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
import { PageHeader } from "@/components/ui/page-header";
import { getEmployeeDashboard } from "@/modules/account/services/accountApi";
import { useAuth } from "@/modules/auth/hooks/useAuth";
 eventTypeConfig: Record<string, { color: string; label: string }> = {
  holiday: { color: "bg-amber-100 text-amber-700", label: "Feriado" },
  vacation: { color: "bg-sky-100 text-sky-700", label: "Vacaciones" },
  leave: { color: "bg-violet-100 text-violet-700", label: "Permiso" },
};
 function MyPortalPage(): JSX.Element {
  const { user } = useAuth();

  const dashboardQuery = useQuery({
    queryKey: ["my-portal-dashboard"],
    queryFn: getEmployeeDashboard,
    enabled: Boolean(user),
  });

  const d = dashboardQuery.data;
  const isLoading = dashboardQuery.isLoading;
  const noEmployee = !isLoading && d === null;

  if (noEmployee) {
    return (
      <section className="animate-fade-up space-y-5">
        <PageHeader title="Mi Portal" description="Panel personal del empleado." />
        <Card>
          <CardContent className="py-10 text-center">
            <p className="text-sm text-muted">No tienes un empleado vinculado a tu cuenta.</p>
          </CardContent>
        </Card>
      </section>
    );
  }

  return (
    <section className="animate-fade-up space-y-5">
      <PageHeader
        title="Mi Portal"
        description={
          d ? `${d.fullName} Â· ${d.areaName} Â· ${d.positionName}` : "Cargando..."
        }
      />

      {/* KPI cards */}
      <div className="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
        <KpiCard
          icon={Clock3}
          label="Asistencia del mes"
          value={isLoading ? "..." : String(d.attendanceDaysPresent  0)}
          detail={`${d.attendanceDaysLate  0} tardanzas Â· ${d.attendanceDaysAbsent  0} faltas`}
          color="text-emerald-600"
          bg="bg-emerald-50"
        />
        <KpiCard
          icon={PlaneTakeoff}
          label="Vacaciones disponibles"
          value={isLoading ? "..." : `${d.vacationDaysAvailable  0} dÃ­as`}
          detail={`${d.vacationDaysUsed  0} usados Â· ${d.vacationDaysPending  0} pendientes`}
          color="text-sky-600"
          bg="bg-sky-50"
        />
        <KpiCard
          icon={FileCheck2}
          label="Permisos del aÃ±o"
          value={isLoading ? "..." : String(d.leaveRequestsTotal  0)}
          detail={`${d.leaveRequestsApproved  0} aprobados Â· ${d.leaveRequestsPending  0} pendientes`}
          color="text-violet-600"
          bg="bg-violet-50"
        />
        <KpiCard
          icon={WalletCards}
          label="Ãšltimo recibo"
          value={
            isLoading
               "..."
              : d.lastNetPay != null
                 `S/ ${d.lastNetPay.toFixed(2)}`
                : "â€”"
          }
          detail={
            d.lastPayrollMonth && d.lastPayrollYear
               `Periodo ${d.lastPayrollMonth}/${d.lastPayrollYear}`
              : "Sin recibos"
          }
          color="text-amber-600"
          bg="bg-amber-50"
        />
      </div>

      {/* Info + Upcoming */}
      <div className="grid gap-4 xl:grid-cols-2">
        {/* Employee info */}
        <Card>
          <CardHeader>
            <div className="flex items-center gap-2">
              <Briefcase className="size-4 text-brand-500" />
              <CardTitle>Mi informaciÃ³n</CardTitle>
            </div>
          </CardHeader>
          <CardContent>
            {isLoading ? (
              <p className="text-sm text-muted">Cargando...</p>
            ) : d ? (
              <div className="grid gap-3 text-[13px] sm:grid-cols-2">
                <InfoItem label="CÃ³digo" value={d.employeeCode} />
                <InfoItem label="Nombre completo" value={d.fullName} />
                <InfoItem label="Ãrea" value={d.areaName} />
                <InfoItem label="Cargo" value={d.positionName} />
                <InfoItem label="Fecha de ingreso" value={d.hireDate} />
                <InfoItem
                  label="AntigÃ¼edad"
                  value={getYearsLabel(d.hireDate)}
                />
              </div>
            ) : null}
          </CardContent>
        </Card>

        {/* Upcoming */}
        <Card>
          <CardHeader>
            <div className="flex items-center gap-2">
              <CalendarClock className="size-4 text-brand-500" />
              <CardTitle>PrÃ³ximos eventos</CardTitle>
            </div>
          </CardHeader>
          <CardContent>
            {isLoading ? (
              <p className="text-sm text-muted">Cargando...</p>
            ) : d.upcomingEvents.length ? (
              <div className="space-y-2">
                {d.upcomingEvents.map((e, i) => {
                  const cfg = eventTypeConfig[e.type]  {
                    color: "bg-slate-100 text-slate-600",
                    label: e.type,
                  };
                  return (
                    <div
                      key={`${e.date}-${i}`}
                      className="flex items-center justify-between rounded-lg border px-3 py-2"
                    >
                      <div className="flex items-center gap-2.5">
                        <span
                          className={`rounded-md px-2 py-0.5 text-[10px] font-bold uppercase ${cfg.color}`}
                        >
                          {cfg.label}
                        </span>
                        <span className="text-[13px] text-slate-700">{e.title}</span>
                      </div>
                      <span className="text-xs text-muted">{e.date}</span>
                    </div>
                  );
                })}
              </div>
            ) : (
              <p className="py-4 text-center text-sm text-muted">
                Sin eventos prÃ³ximos
              </p>
            )}
          </CardContent>
        </Card>
      </div>

      {/* Attendance summary */}
      <Card>
        <CardHeader>
          <div className="flex items-center gap-2">
            <TrendingUp className="size-4 text-brand-500" />
            <CardTitle>Resumen del mes actual</CardTitle>
          </div>
        </CardHeader>
        <CardContent>
          {isLoading ? (
            <p className="text-sm text-muted">Cargando...</p>
          ) : d ? (
            <div className="grid gap-4 sm:grid-cols-3">
              <MiniStat label="DÃ­as presentes" value={d.attendanceDaysPresent} color="text-emerald-600" icon={CalendarCheck} />
              <MiniStat label="Tardanzas" value={d.attendanceDaysLate} color="text-amber-600" icon={Clock3} />
              <MiniStat label="Faltas" value={d.attendanceDaysAbsent} color="text-red-500" icon={CalendarClock} />
            </div>
          ) : null}
        </CardContent>
      </Card>
    </section>
  );
}

// â”€â”€ helpers â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ ? function InfoItem({ label, value }: { label: string; value: string }): JSX.Element {
  return (
    <div>
      <p className="text-[11px] font-semibold uppercase tracking-wide text-slate-400">{label}</p>
      <p className="mt-0.5 text-slate-700">{value}</p>
    </div>
  );
}
 KpiCard({
  icon: Icon,
  label,
  value,
  detail,
  color,
  bg,
}: {
  icon: React.ComponentType<{ className: string }>;
  label: string;
  value: string;
  detail: string;
  color: string;
  bg: string;
}): JSX.Element {
  return (
    <Card>
      <CardContent className="flex items-start gap-3 py-4">
        <div className={`rounded-lg p-2 ${bg}`}>
          <Icon className={`size-5 ${color}`} />
        </div>
        <div className="min-w-0 flex-1">
          <p className="text-xs font-semibold uppercase tracking-wide text-muted">{label}</p>
          <p className="mt-0.5 text-xl font-extrabold">{value}</p>
          <p className="mt-0.5 text-[11px] text-muted">{detail}</p>
        </div>
      </CardContent>
    </Card>
  );
}
 MiniStat({
  label,
  value,
  color,
  icon: Icon,
}: {
  label: string;
  value: number;
  color: string;
  icon: React.ComponentType<{ className: string }>;
}): JSX.Element {
  return (
    <div className="flex items-center gap-3 rounded-xl border px-4 py-3">
      <Icon className={`size-5 ${color}`} />
      <div>
        <p className="text-xl font-bold">{value}</p>
        <p className="text-xs text-muted">{label}</p>
      </div>
    </div>
  );
}
 getYearsLabel(hireDateStr: string): string {
  const hire = new Date(hireDateStr);
  const now = new Date();
  const diffMs = now.getTime() - hire.getTime();
  const years = Math.floor(diffMs / (365.25 * 24 * 60 * 60 * 1000));
  const months = Math.floor(
    (diffMs % (365.25 * 24 * 60 * 60 * 1000)) / (30.44 * 24 * 60 * 60 * 1000)
  );
  if (years > 0) return `${years} aÃ±o${years > 1 ? "s" : ""} y ${months} mes${months !== 1 ? "es" : ""}`;
  return `${months} mes${months !== 1 ? "es" : ""}`;
}


