import { useEffect } from "react";
import { useForm } from "react-hook-form";
import { useQuery } from "@tanstack/react-query";
import { z } from "zod";
import { zodResolver } from "@hookform/resolvers/zod";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Modal } from "@/components/ui/modal";
import { Select } from "@/components/ui/select";
import { Textarea } from "@/components/ui/textarea";
import { FormField } from "@/components/forms/FormField";
import { getOpenJobPostings } from "@/modules/recruitment/services/jobPostingsApi";
import type {
  RecruitmentCandidateDetail,
  RecruitmentCandidatePayload,
  RecruitmentCatalogs
} from "@/modules/recruitment/types/recruitment.types";
 schema = z.object({
  fullName: z.string().min(3, "Nombre requerido"),
  email: z.string().email("Correo invalido"),
  phoneNumber: z.string().min(6, "Telefono requerido"),
  positionApplied: z.string().min(2, "Puesto requerido"),
  expectedSalary: z.string().optional(),
  source: z.string().optional(),
  currentStatus: z.string().min(1, "Estado requerido"),
  isPotentialHire: z.enum(["yes", "no"]),
  applicationDate: z.string().min(1, "Fecha requerida"),
  nextStepDate: z.string().optional(),
  notes: z.string().optional(),
  jobPostingId: z.string().optional()
});
 RecruitmentFormValues = z.infer<typeof schema>;
 defaultValues: RecruitmentFormValues = {
  fullName: "",
  email: "",
  phoneNumber: "",
  positionApplied: "",
  expectedSalary: "",
  source: "",
  currentStatus: "new",
  isPotentialHire: "no",
  applicationDate: new Date().toISOString().slice(0, 10),
  nextStepDate: "",
  notes: "",
  jobPostingId: ""
};
 RecruitmentCandidateFormModalProps = {
  open: boolean;
  mode: "create" | "edit";
  catalogs: RecruitmentCatalogs | undefined;
  candidate: RecruitmentCandidateDetail | null;
  loadingCandidate: boolean;
  saving: boolean;
  onClose: () => void;
  onSubmit: (payload: RecruitmentCandidatePayload) => Promise<void>;
};
 function ModalFormCandidato({
  open,
  mode,
  catalogs,
  candidate,
  loadingCandidate,
  saving,
  onClose,
  onSubmit
}: RecruitmentCandidateFormModalProps): JSX.Element {
  const {
    register,
    handleSubmit,
    reset,
    formState: { errors }
  } = useForm<RecruitmentFormValues>({
    resolver: zodResolver(schema),
    defaultValues
  });

  const jobPostingsQuery = useQuery({
    queryKey: ["open-job-postings"],
    queryFn: getOpenJobPostings,
    enabled: open
  });

  useEffect(() => {
    if (!open) return;

    if (mode === "edit" && candidate) {
      reset({
        fullName: candidate.fullName,
        email: candidate.email,
        phoneNumber: candidate.phoneNumber,
        positionApplied: candidate.positionApplied,
        expectedSalary: typeof candidate.expectedSalary === "number" ? String(candidate.expectedSalary) : "",
        source: candidate.source ? "",
        currentStatus: candidate.currentStatus,
        isPotentialHire: candidate.isPotentialHire ? "yes" : "no",
        applicationDate: candidate.applicationDate,
        nextStepDate: candidate.nextStepDate ? "",
        notes: candidate.notes ? "",
        jobPostingId: candidate.jobPostingId ? ""
      });
      return;
    }

    reset(defaultValues);
  }, [candidate, mode, open, reset]);

  const title = mode === "create" ? "Nuevo postulante" : "Editar postulante";

  const submit = handleSubmit(async (values) => {
    const expectedSalary = values.expectedSalary.trim()
       Number(values.expectedSalary)
      : undefined;

    if (typeof expectedSalary === "number" && !Number.isFinite(expectedSalary)) {
      return;
    }

    await onSubmit({
      fullName: values.fullName.trim(),
      email: values.email.trim(),
      phoneNumber: values.phoneNumber.trim(),
      positionApplied: values.positionApplied.trim(),
      expectedSalary,
      source: values.source.trim() || undefined,
      currentStatus: values.currentStatus as RecruitmentCandidatePayload["currentStatus"],
      isPotentialHire: values.isPotentialHire === "yes",
      applicationDate: values.applicationDate,
      nextStepDate: values.nextStepDate.trim() || undefined,
      notes: values.notes.trim() || undefined,
      jobPostingId: values.jobPostingId.trim() || undefined
    });
  });

  return (
    <Modal open={open} title={title} onClose={onClose}>
      {mode === "edit" && loadingCandidate ? (
        <div className="py-8 text-sm text-muted">Cargando postulante...</div>
      ) : (
        <form className="space-y-4" onSubmit={submit}>
          <div className="grid gap-4 md:grid-cols-2">
            <FormField label="Nombre completo" error={errors.fullName.message}>
              <Input {...register("fullName")} />
            </FormField>
            <FormField label="Correo" error={errors.email.message}>
              <Input type="email" {...register("email")} />
            </FormField>
          </div>

          <div className="grid gap-4 md:grid-cols-2">
            <FormField label="Telefono" error={errors.phoneNumber.message}>
              <Input {...register("phoneNumber")} />
            </FormField>
            <FormField label="Puesto postulado" error={errors.positionApplied.message}>
              <Input {...register("positionApplied")} />
            </FormField>
          </div>

          <div className="grid gap-4 md:grid-cols-2">
            <FormField label="Expectativa salarial" error={errors.expectedSalary.message}>
              <Input type="number" step="0.01" min="0" {...register("expectedSalary")} />
            </FormField>
            <FormField label="Fuente" error={errors.source.message}>
              <Input placeholder="LinkedIn, Referido, etc." {...register("source")} />
            </FormField>
          </div>

          <FormField label="Vacante asociada (opcional)" error={errors.jobPostingId.message}>
            <Select {...register("jobPostingId")}>
              <option value="">Sin vacante</option>
              {jobPostingsQuery.data.map((jp) => (
                <option key={jp.id} value={jp.id}>{jp.title}{jp.positionName ? ` â€” ${jp.positionName}` : ""}</option>
              ))}
            </Select>
          </FormField>

          <div className="grid gap-4 md:grid-cols-3">
            <FormField label="Fecha postulacion" error={errors.applicationDate.message}>
              <Input type="date" {...register("applicationDate")} />
            </FormField>
            <FormField label="Proximo paso" error={errors.nextStepDate.message}>
              <Input type="date" {...register("nextStepDate")} />
            </FormField>
            <FormField label="Posible contratacion futura" error={errors.isPotentialHire.message}>
              <Select {...register("isPotentialHire")}>
                <option value="no">No</option>
                <option value="yes">Si</option>
              </Select>
            </FormField>
          </div>

          <div className="grid gap-4 md:grid-cols-2">
            <FormField label="Estado inicial" error={errors.currentStatus.message}>
              <Select {...register("currentStatus")} disabled={mode === "edit"}>
                {catalogs.statuses.map((status) => (
                  <option key={status.code} value={status.code}>{status.name}</option>
                ))}
              </Select>
            </FormField>
          </div>

          <FormField label="Observaciones" error={errors.notes.message}>
            <Textarea rows={4} {...register("notes")} />
          </FormField>

          <div className="flex justify-end gap-2">
            <Button type="button" variant="secondary" onClick={onClose}>
              Cancelar
            </Button>
            <Button type="submit" disabled={saving || loadingCandidate}>
              {saving ? "Guardando..." : mode === "create" ? "Crear postulante" : "Guardar cambios"}
            </Button>
          </div>
        </form>
      )}
    </Modal>
  );
}


