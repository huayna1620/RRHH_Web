import { useState } from "react";
import { useMutation, useQuery, useQueryClient } from "@tanstack/react-query";
import { Plus, Shield } from "lucide-react";
import { useAuth } from "@/modules/auth/hooks/useAuth";
import { Badge } from "@/components/ui/badge";
import { Button } from "@/components/ui/button";
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
import { Input } from "@/components/ui/input";
import { Alert } from "@/components/ui/alert";
import { TableSkeleton } from "@/components/ui/skeleton";
import { TableEmptyState } from "@/components/ui/empty-state";
import { PageHeader } from "@/components/ui/page-header";
import { Modal } from "@/components/ui/modal";
import { RolePermissionsModal } from "@/modules/roles/components/RolePermissionsModal";
import { getRoles, createRole, getPermissions, getRolePermissionIds, updateRolePermissions } from "@/modules/roles/services/rolesApi";
import type { RoleItem } from "@/modules/roles/types/role.types";
 PermModalState = { role: RoleItem; permissionIds: string[] } | null;
 function PaginaRoles(): JSX.Element {
  const { user: authUser } = useAuth();
  const queryClient = useQueryClient();
  const canEdit = authUser.permissions.includes("roles.edit");

  const [createOpen, setCreateOpen] = useState(false);
  const [roleName, setRoleName] = useState("");
  const [roleDesc, setRoleDesc] = useState("");
  const [createError, setCreateError] = useState<string | null>(null);
  const [permModal, setPermModal] = useState<PermModalState>(null);
  const [error, setError] = useState<string | null>(null);

  const { data: roles, isLoading } = useQuery({ queryKey: ["roles"], queryFn: getRoles });
  const { data: allPermissions } = useQuery({ queryKey: ["permissions"], queryFn: getPermissions });

  const createMutation = useMutation({
    mutationFn: () => createRole({ name: roleName.trim(), description: roleDesc.trim() }),
    onSuccess: () => {
      queryClient.invalidateQueries({ queryKey: ["roles"] });
      setCreateOpen(false);
      setRoleName("");
      setRoleDesc("");
    },
    onError: (err: Error) => setCreateError(err.message),
  });

  async function handleOpenPermissions(role: RoleItem): Promise<void> {
    try {
      const permissionIds = await getRolePermissionIds(role.id);
      setPermModal({ role, permissionIds });
    } catch {
      setError("Error al cargar permisos del rol.");
    }
  }

  async function handleSavePermissions(roleId: string, permissionIds: string[]): Promise<void> {
    await updateRolePermissions(roleId, permissionIds);
    queryClient.invalidateQueries({ queryKey: ["roles"] });
  }

  return (
    <div className="space-y-6">
      <PageHeader title="Roles" description="GestiÃ³n de roles y permisos del sistema" />

      {error && <Alert variant="error" message={error} onClose={() => setError(null)} />}

      <Card>
        <CardHeader>
          <div className="flex flex-wrap items-center justify-between gap-4">
            <CardTitle>Listado de roles</CardTitle>
            {canEdit && (
              <Button
                size="lg"
                className="btn-create"
                onClick={() => { setCreateOpen(true); setCreateError(null); }}
              >
                <Plus className="size-4" /> Nuevo rol
              </Button>
            )}
          </div>
        </CardHeader>
        <CardContent>
          {isLoading ? (
            <TableSkeleton rows={3} cols={4} />
          ) : !roles || roles.length === 0 ? (
            <TableEmptyState cols={4} message="No se encontraron roles." />
          ) : (
            <>
              <div className="space-y-3 md:hidden">
                {roles.map((r) => (
                  <article key={r.id} className="rounded-xl border border-slate-200 bg-white p-3 shadow-sm">
                    <div className="flex items-start justify-between gap-3">
                      <div>
                        <p className="text-sm font-bold text-slate-800">{r.name}</p>
                        <p className="mt-1 text-xs text-slate-500">{r.description}</p>
                      </div>
                      <Badge variant={r.isActive ? "success" : "danger"}>
                        {r.isActive ? "Activo" : "Inactivo"}
                      </Badge>
                    </div>
                    {canEdit && (
                      <div className="mt-3">
                        <Button
                          variant="secondary"
                          size="sm"
                          className="w-full"
                          onClick={() => handleOpenPermissions(r)}
                        >
                          <Shield className="size-3.5" /> Gestionar permisos
                        </Button>
                      </div>
                    )}
                  </article>
                ))}
              </div>
              <div className="hidden overflow-x-auto md:block">
              <table className="w-full text-left text-sm">
                <thead>
                  <tr className="border-b text-xs font-semibold uppercase tracking-wider text-slate-500">
                    <th className="px-3 py-2.5">Nombre</th>
                    <th className="px-3 py-2.5">DescripciÃ³n</th>
                    <th className="px-3 py-2.5">Estado</th>
                    {canEdit && <th className="px-3 py-2.5 text-right">Acciones</th>}
                  </tr>
                </thead>
                <tbody>
                  {roles.map((r) => (
                    <tr key={r.id} className="border-b last:border-0 hover:bg-slate-50/50">
                      <td className="px-3 py-2.5 font-medium">{r.name}</td>
                      <td className="px-3 py-2.5 text-slate-500">{r.description}</td>
                      <td className="px-3 py-2.5">
                        <Badge variant={r.isActive ? "success" : "danger"}>
                          {r.isActive ? "Activo" : "Inactivo"}
                        </Badge>
                      </td>
                      {canEdit && (
                        <td className="px-3 py-2.5 text-right">
                          <button
                            className="rounded-md p-1.5 text-slate-400 transition hover:bg-slate-100 hover:text-slate-600"
                            title="Gestionar permisos"
                            onClick={() => handleOpenPermissions(r)}
                          >
                            <Shield className="size-3.5" />
                          </button>
                        </td>
                      )}
                    </tr>
                  ))}
                </tbody>
              </table>
              </div>
            </>
          )}
        </CardContent>
      </Card>

      {/* Create Role Modal */}
      <Modal open={createOpen} title="Nuevo rol" onClose={() => setCreateOpen(false)}>
        <form
          className="space-y-4"
          onSubmit={(e) => {
            e.preventDefault();
            createMutation.mutate();
          }}
        >
          {createError && <Alert variant="error" message={createError} />}
          <div>
            <label className="mb-1.5 block text-xs font-semibold text-slate-600">Nombre del rol *</label>
            <Input value={roleName} onChange={(e) => setRoleName(e.target.value)} required />
          </div>
          <div>
            <label className="mb-1.5 block text-xs font-semibold text-slate-600">DescripciÃ³n *</label>
            <Input value={roleDesc} onChange={(e) => setRoleDesc(e.target.value)} required />
          </div>
          <div className="grid grid-cols-1 gap-2 sm:flex sm:justify-end">
            <Button variant="ghost" type="button" onClick={() => setCreateOpen(false)}>Cancelar</Button>
            <Button type="submit" disabled={createMutation.isPending}>
              {createMutation.isPending ? "Creando..." : "Crear rol"}
            </Button>
          </div>
        </form>
      </Modal>

      {/* Permissions Modal */}
      <RolePermissionsModal
        open={permModal !== null}
        role={permModal.role ? null}
        allPermissions={allPermissions ?? []}
        currentPermissionIds={permModal.permissionIds ?? []}
        onClose={() => setPermModal(null)}
        onSubmit={handleSavePermissions}
      />
    </div>
  );
}



