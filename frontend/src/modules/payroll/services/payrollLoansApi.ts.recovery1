import { httpClient } from "@/services/api/httpClient";
import type { CreatePayrollLoanRequest, PagedResult, PayrollLoan } from "@/modules/payroll/types/payroll.types";
 async function getPayrollLoans(params: {
  employeeId: string;
  activeOnly: boolean;
  pageNumber: number;
  pageSize: number;
}): Promise<PagedResult<PayrollLoan>> {
  const query = new URLSearchParams();
  if (params.employeeId) query.set("employeeId", params.employeeId);
  if (params.activeOnly !== undefined) query.set("activeOnly", String(params.activeOnly));
  query.set("pageNumber", String(params.pageNumber  1));
  query.set("pageSize", String(params.pageSize  20));

  const { data } = await httpClient.get<PagedResult<PayrollLoan>>(`/api/v1/payroll/loans${query.toString()}`);
  return data;
}
 async function createPayrollLoan(payload: CreatePayrollLoanRequest): Promise<PayrollLoan> {
  const { data } = await httpClient.post<PayrollLoan>("/api/v1/payroll/loans", payload);
  return data;
}
 async function cancelPayrollLoan(id: string): Promise<void> {
  await httpClient.post(`/api/v1/payroll/loans/${id}/cancel`);
}


