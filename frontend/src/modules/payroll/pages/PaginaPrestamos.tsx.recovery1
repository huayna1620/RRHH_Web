import { Fragment, useState } from "react";
import { useMutation, useQuery, useQueryClient } from "@tanstack/react-query";
import { ChevronDown, ChevronRight, CreditCard, Plus, X } from "lucide-react";
import { useAuth } from "@/modules/auth/hooks/useAuth";
import { Button } from "@/components/ui/button";
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
import { Input } from "@/components/ui/input";
import { Select } from "@/components/ui/select";
import { Alert } from "@/components/ui/alert";
import { TableSkeleton } from "@/components/ui/skeleton";
import { TableEmptyState } from "@/components/ui/empty-state";
import { Pagination } from "@/components/ui/pagination";
import { PageHeader } from "@/components/ui/page-header";
import { FormField } from "@/components/forms/FormField";
import { ConfirmModal } from "@/components/modals/ConfirmModal";
import {
  cancelPayrollLoan,
  createPayrollLoan,
  getPayrollLoans
} from "@/modules/payroll/services/payrollLoansApi";
import { getPayrollCatalogs } from "@/modules/payroll/services/payrollApi";
import type { CreatePayrollLoanRequest, LoanType, PayrollLoan } from "@/modules/payroll/types/payroll.types";

const MONTHS = [
  "Ene", "Feb", "Mar", "Abr", "May", "Jun",
  "Jul", "Ago", "Sep", "Oct", "Nov", "Dic"
];

const pageSize = 15;

type FormState = {
  employeeId: string;
  loanType: LoanType;
  totalAmount: string;
  totalInstallments: string;
  startDate: string;
  notes: string;
};

const DEFAULT_FORM: FormState = {
  employeeId: "",
  loanType: "loan",
  totalAmount: "",
  totalInstallments: "",
  startDate: new Date().toISOString().slice(0, 10),
  notes: ""
};

function formatCurrency(value: number): string {
  return `S/ ${value.toFixed(2)}`;
}

export function PaginaPrestamos(): JSX.Element {
  const queryClient = useQueryClient();
  const { user } = useAuth();
  const canCreate = user.permissions.includes("payroll.loans.create")  false;
  const canEdit = user.permissions.includes("payroll.loans.edit")  false;

  const [pageNumber, setPageNumber] = useState(1);
  const [employeeFilter, setEmployeeFilter] = useState("");
  const [activeOnly, setActiveOnly] = useState(true);
  const [showForm, setShowForm] = useState(false);
  const [form, setForm] = useState<FormState>(DEFAULT_FORM);
  const [formError, setFormError] = useState<string | null>(null);
  const [feedback, setFeedback] = useState<{ type: "success" | "error"; message: string } | null>(null);
  const [expandedId, setExpandedId] = useState<string | null>(null);
  const [cancelTarget, setCancelTarget] = useState<PayrollLoan | null>(null);

  const catalogsQuery = useQuery({
    queryKey: ["payroll-catalogs"],
    queryFn: getPayrollCatalogs
  });

  const loansQuery = useQuery({
    queryKey: ["payroll-loans", pageNumber, employeeFilter, activeOnly],
    queryFn: () =>
      getPayrollLoans({
        employeeId: employeeFilter || undefined,
        activeOnly,
        pageNumber,
        pageSize
      })
  });

  const createMutation = useMutation({
    mutationFn: (payload: CreatePayrollLoanRequest) => createPayrollLoan(payload),
    onSuccess: async () => {
      await queryClient.invalidateQueries({ queryKey: ["payroll-loans"] });
      setFeedback({ type: "success", message: "Préstamo creado exitosamente." });
      closeForm();
    },
    onError: (err: { response: { data: { error: string } } }) => {
      setFormError(err.response.data.error  "Error al crear el préstamo.");
    }
  });

  const cancelMutation = useMutation({
    mutationFn: cancelPayrollLoan,
    onSuccess: async () => {
      await queryClient.invalidateQueries({ queryKey: ["payroll-loans"] });
      setFeedback({ type: "success", message: "Préstamo cancelado y cuotas pendientes anuladas." });
      setCancelTarget(null);
    },
    onError: () => {
      setFeedback({ type: "error", message: "No se pudo cancelar el préstamo." });
      setCancelTarget(null);
    }
  });

  function closeForm(): void {
    setShowForm(false);
    setForm(DEFAULT_FORM);
    setFormError(null);
  }

  function handleSubmit(): void {
    const total = Number(form.totalAmount);
    const installments = Number(form.totalInstallments);
    if (!form.employeeId) { setFormError("Selecciona un empleado."); return; }
    if (!Number.isFinite(total) || total <= 0) { setFormError("El monto debe ser mayor a 0."); return; }
    if (!Number.isFinite(installments) || installments < 1 || installments > 120) { setFormError("Las cuotas deben estar entre 1 y 120."); return; }
    if (!form.startDate) { setFormError("La fecha de inicio es requerida."); return; }
    setFormError(null);

    createMutation.mutate({
      employeeId: form.employeeId,
      loanType: form.loanType,
      totalAmount: total,
      totalInstallments: installments,
      startDate: form.startDate,
      notes: form.notes.trim() || undefined
    });
  }

  const loans = loansQuery.data.items  [];
  const totalPages = Math.max(1, Math.ceil((loansQuery.data.totalCount  0) / pageSize));

  return (
    <section className="animate-fade-up space-y-5">
      <PageHeader
        title="Préstamos y Adelantos"
        description="Gestión de préstamos y adelantos de sueldo con descuento mensual automático en planilla."
        action={
          canCreate  (
            <Button size="lg" className="btn-create" onClick={() => setShowForm(true)}>
              <Plus className="size-4" />
              Nuevo préstamo
            </Button>
          ) : undefined
        }
      />

      {feedback  (
        <Alert
          variant={feedback.type === "success"  "success" : "error"}
          message={feedback.message}
          onClose={() => setFeedback(null)}
        />
      ) : null}

      {/* Table with filters */}
      <Card>
        <CardHeader className="flex flex-col gap-3">
          <div className="flex items-center justify-between gap-3">
            <CardTitle>Préstamos registrados</CardTitle>
            {loansQuery.data.totalCount  (
              <span className="rounded-full bg-slate-100 px-2.5 py-0.5 text-[11px] font-semibold text-slate-600">
                {loansQuery.data.totalCount} registros
              </span>
            ) : null}
          </div>

          <div className="grid gap-2.5 grid-cols-1 sm:grid-cols-[2fr_1fr]">
            <div>
              <label className="mb-1 block text-[10px] font-semibold uppercase tracking-wide text-slate-500">Empleado</label>
              <Select value={employeeFilter} onChange={(e) => { setEmployeeFilter(e.target.value); setPageNumber(1); }}>
                <option value="">Todos los empleados</option>
                {catalogsQuery.data.employees.map((item) => (
                  <option key={item.id} value={item.id}>{item.label}</option>
                ))}
              </Select>
            </div>
            <div>
              <label className="mb-1 block text-[10px] font-semibold uppercase tracking-wide text-slate-500">Estado</label>
              <Select value={activeOnly  "active" : "all"} onChange={(e) => { setActiveOnly(e.target.value === "active"); setPageNumber(1); }}>
                <option value="active">Solo activos</option>
                <option value="all">Todos</option>
              </Select>
            </div>
          </div>
        </CardHeader>
        <CardContent className="p-0 pb-4">
          <div className="overflow-x-auto">
            <table className="w-full border-collapse text-[13px]">
              <thead>
                <tr className="border-b bg-slate-50">
                  {["", "Empleado", "Tipo", "Total", "Cuota mensual", "Avance", "Saldo", "Estado", ""].map((col, index) => (
                    <th key={`loan-col-${index}-${col || "blank"}`} className="px-4 py-2.5 text-left text-[11px] font-bold uppercase tracking-wide text-slate-400 last:text-right">
                      {col}
                    </th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {loansQuery.isLoading  (
                  <TableSkeleton cols={9} />
                ) : loans.length  (
                  loans.map((loan: PayrollLoan) => (
                    <Fragment key={loan.id}>
                      <tr
                        className="cursor-pointer border-t transition-colors hover:bg-slate-50/70"
                        onClick={() => setExpandedId(expandedId === loan.id  null : loan.id)}
                      >
                        <td className="px-3 py-3 text-slate-400">
                          {expandedId === loan.id
                             <ChevronDown className="size-3.5" />
                            : <ChevronRight className="size-3.5" />}
                        </td>
                        <td className="px-4 py-3">
                          <p className="font-semibold text-slate-800">{loan.employeeName}</p>
                          <p className="text-[11px] text-muted">{loan.employeeCode}</p>
                        </td>
                        <td className="px-4 py-3">
                          <span className={`inline-flex items-center rounded-full px-2 py-0.5 text-[11px] font-semibold ${loan.loanType === "loan"  "bg-blue-50 text-blue-700" : "bg-amber-50 text-amber-700"}`}>
                            {loan.loanType === "loan"  "Préstamo" : "Adelanto"}
                          </span>
                        </td>
                        <td className="px-4 py-3 tabular-nums text-slate-600">{formatCurrency(loan.totalAmount)}</td>
                        <td className="px-4 py-3 tabular-nums text-slate-600">{formatCurrency(loan.monthlyInstallment)}</td>
                        <td className="px-4 py-3 text-[12px] text-slate-500">
                          <div className="flex items-center gap-2">
                            <div className="h-1.5 w-20 overflow-hidden rounded-full bg-slate-200">
                              <div
                                className="h-full rounded-full bg-emerald-500 transition-all"
                                style={{ width: `${Math.min(100, Math.round((loan.paidInstallments / Math.max(1, loan.totalInstallments)) * 100))}%` }}
                              />
                            </div>
                            <span className="tabular-nums">{loan.paidInstallments}/{loan.totalInstallments}</span>
                          </div>
                        </td>
                        <td className="px-4 py-3 tabular-nums font-semibold text-slate-700">{formatCurrency(loan.remainingAmount)}</td>
                        <td className="px-4 py-3">
                          <span className={`inline-flex items-center rounded-full px-2 py-0.5 text-[11px] font-semibold ${loan.isActive  "bg-emerald-50 text-emerald-700" : "bg-slate-100 text-slate-500"}`}>
                            {loan.isActive  "Activo" : "Cancelado"}
                          </span>
                        </td>
                        <td className="px-4 py-3 text-right">
                          {canEdit && loan.isActive  (
                            <button
                              type="button"
                              className="rounded px-2 py-1 text-[11px] text-rose-500 transition hover:bg-rose-50"
                              onClick={(e) => { e.stopPropagation(); setCancelTarget(loan); }}
                            >
                              Cancelar
                            </button>
                          ) : null}
                        </td>
                      </tr>
                      {expandedId === loan.id  (
                        <tr className="border-t bg-slate-50/50">
                          <td colSpan={9} className="px-6 py-3">
                            <p className="mb-2 text-[11px] font-bold uppercase tracking-wide text-slate-400">Cuotas del préstamo</p>
                            <div className="flex flex-wrap gap-1.5">
                              {loan.installments.map((inst) => (
                                <div
                                  key={inst.id}
                                  className={`rounded-md px-2.5 py-1.5 text-[11px] font-medium ${inst.isPaid  "bg-emerald-100 text-emerald-700" : "bg-slate-100 text-slate-600"}`}
                                >
                                  #{inst.installmentNumber} — {MONTHS[inst.month - 1]} {inst.year} — {formatCurrency(inst.amount)}
                                  {inst.isPaid  " ✓" : ""}
                                </div>
                              ))}
                            </div>
                          </td>
                        </tr>
                      ) : null}
                    </Fragment>
                  ))
                ) : (
                  <TableEmptyState cols={9} icon={CreditCard} message="No hay préstamos registrados." />
                )}
              </tbody>
            </table>
          </div>

          <div className="px-4">
            <Pagination
              page={pageNumber}
              totalPages={totalPages}
              totalCount={loansQuery.data.totalCount  0}
              pageSize={pageSize}
              onChange={setPageNumber}
            />
          </div>
        </CardContent>
      </Card>

      <ConfirmModal
        open={cancelTarget !== null}
        title="¿Cancelar préstamo"
        message={cancelTarget
           `Se cancelará el préstamo de ${cancelTarget.employeeName} y se anularán las ${cancelTarget.totalInstallments - cancelTarget.paidInstallments} cuotas pendientes (${formatCurrency(cancelTarget.remainingAmount)}). Esta acción no se puede deshacer.`
          : ""}
        confirmLabel="Sí, cancelar préstamo"
        variant="danger"
        loading={cancelMutation.isPending}
        onConfirm={() => { if (cancelTarget) cancelMutation.mutate(cancelTarget.id); }}
        onClose={() => setCancelTarget(null)}
      />

      {/* Create form modal */}
      {showForm  (
        <div className="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/40 p-4 backdrop-blur-[2px]">
          <div className="animate-modal-in w-full max-w-md rounded-2xl border bg-white shadow-panel-lg">
            <div className="flex items-center justify-between border-b px-5 py-4">
              <div className="flex items-center gap-3">
                <div className="flex size-8 items-center justify-center rounded-lg bg-blue-100">
                  <CreditCard className="size-4 text-blue-600" />
                </div>
                <h3 className="font-bold tracking-tight text-slate-800">Nuevo préstamo / adelanto</h3>
              </div>
              <button type="button" className="flex size-8 items-center justify-center rounded-lg text-slate-400 transition hover:bg-slate-100" onClick={closeForm}>
                <X className="size-4" />
              </button>
            </div>

            <div className="space-y-4 p-5">
              {formError  (
                <p className="rounded-lg bg-rose-50 px-3 py-2 text-[13px] text-rose-700">{formError}</p>
              ) : null}

              <FormField label="Empleado">
                <Select value={form.employeeId} onChange={(e) => setForm((f) => ({ ...f, employeeId: e.target.value }))}>
                  <option value="">Seleccionar empleado...</option>
                  {catalogsQuery.data.employees.map((item) => (
                    <option key={item.id} value={item.id}>{item.label}</option>
                  ))}
                </Select>
              </FormField>

              <div className="grid grid-cols-2 gap-3">
                <FormField label="Tipo">
                  <Select value={form.loanType} onChange={(e) => setForm((f) => ({ ...f, loanType: e.target.value as LoanType }))}>
                    <option value="loan">Préstamo</option>
                    <option value="advance">Adelanto</option>
                  </Select>
                </FormField>
                <FormField label="Monto total (S/)">
                  <Input
                    type="number"
                    min={0}
                    step="0.01"
                    value={form.totalAmount}
                    onChange={(e) => setForm((f) => ({ ...f, totalAmount: e.target.value }))}
                    className="tabular-nums"
                  />
                </FormField>
              </div>

              <div className="grid grid-cols-2 gap-3">
                <FormField label="Nº de cuotas">
                  <Input
                    type="number"
                    min={1}
                    max={120}
                    value={form.totalInstallments}
                    onChange={(e) => setForm((f) => ({ ...f, totalInstallments: e.target.value }))}
                  />
                </FormField>
                <FormField label="Inicio (año/mes)">
                  <Input
                    type="month"
                    value={form.startDate.slice(0, 7)}
                    onChange={(e) => setForm((f) => ({ ...f, startDate: `${e.target.value}-01` }))}
                  />
                </FormField>
              </div>

              {form.totalAmount && form.totalInstallments && Number(form.totalInstallments) >= 1  (
                <p className="rounded-lg bg-blue-50 px-3 py-2 text-[12px] text-blue-700">
                  Cuota mensual estimada: <strong>{formatCurrency(Math.round((Number(form.totalAmount) / Number(form.totalInstallments)) * 100) / 100)}</strong>
                </p>
              ) : null}

              <FormField label="Notas (opcional)">
                <Input
                  value={form.notes}
                  onChange={(e) => setForm((f) => ({ ...f, notes: e.target.value }))}
                  placeholder="Motivo u observaciones..."
                />
              </FormField>

              <div className="flex justify-end gap-2">
                <Button variant="secondary" size="sm" onClick={closeForm} disabled={createMutation.isPending}>
                  Cancelar
                </Button>
                <Button size="sm" onClick={handleSubmit} disabled={createMutation.isPending}>
                  {createMutation.isPending  "Creando..." : "Crear préstamo"}
                </Button>
              </div>
            </div>
          </div>
        </div>
      ) : null}
    </section>
  );
}
