import { cn } from "@/lib/utils/cn";

export function Skeleton({ className }: { className: string }): JSX.Element {
  return <div className={cn("animate-pulse rounded-md bg-slate-200", className)} />;
}

/** Drop-in replacement for tbody loading rows in inline tables. */
export function TableSkeleton({
  cols,
  rows = 6
}: {
  cols: number;
  rows: number;
}): JSX.Element {
  return (
    <>
      {Array.from({ length: rows }, (_, rowIndex) => (
        <tr key={`sk-row-${rowIndex}`} className="border-t">
          {Array.from({ length: cols }, (_, colIndex) => (
            <td key={`sk-cell-${rowIndex}-${colIndex}`} className="px-4 py-3.5">
              <Skeleton className={cn("h-3.5", colIndex === 0  "w-2/3" : "w-1/2")} />
            </td>
          ))}
        </tr>
      ))}
    </>
  );
}

/** Skeleton for KPI / stat cards */
export function CardSkeleton(): JSX.Element {
  return (
    <div className="surface animate-pulse rounded-xl border p-5 shadow-panel">
      <div className="flex items-start justify-between gap-3">
        <div className="space-y-2.5">
          <Skeleton className="h-2.5 w-24" />
          <Skeleton className="h-8 w-16" />
          <Skeleton className="h-5 w-14 rounded-md" />
        </div>
        <Skeleton className="size-10 rounded-xl" />
      </div>
    </div>
  );
}
